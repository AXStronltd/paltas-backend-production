# Copy to server/.env for local use (never commit .env). Values here are placeholders, not secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# PostgreSQL 14 or newer. Local example (see backend/README.md for starting one):
DATABASE_URL=postgres://paltas@127.0.0.1:5432/paltas
DATABASE_POOL_SIZE=10
# provider = orders wait for a signed payment event (always in production). simulated = local demo only.
BILLING_MODE=provider
SESSION_MINUTES=30
# Comma-separated front-end origins allowed to call the API, e.g. https://app.paltashub.com
CORS_ORIGINS=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts authenticator secrets. Required in production.
SECRETS_KEY=
# One signing secret per payment provider adapter: WEBHOOK_SECRET_<PROVIDER>=...
# WEBHOOK_SECRET_MPESA=
# WEBHOOK_SECRET_CARDS=
# Security alarm-monitoring providers sign their events the same way (POST /api/v1/webhooks/security/alarms/<provider>):
# WEBHOOK_SECRET_<ALARMPROVIDER>=
# Pin the business date for demos only. Refused in production.
PALTAS_TODAY=
TRUST_PROXY=false
LOG_LEVEL=info
LOGIN_RATE_LIMIT_PER_MINUTE=20
# Data migration: upload limits (MB), ZIP safety, rows per import batch, and the background import worker
MIGRATION_MAX_FILE_MB=50
MIGRATION_MAX_JOB_MB=500
# files announced but not yet completed, per migration (each counts its announced size against the total)
MIGRATION_MAX_OPEN_UPLOADS=20
MIGRATION_ZIP_MAX_ENTRIES=2000
MIGRATION_ZIP_MAX_UNCOMPRESSED_MB=200
MIGRATION_BATCH_SIZE=500
MIGRATION_WORKER=true
MIGRATION_WORKER_POLL_MS=1000
MIGRATION_LEASE_MS=60000
# Public marketplace abuse limits per caller address (set TRUST_PROXY=true behind a proxy so the real address is used)
MARKETPLACE_SEARCH_PER_MINUTE=120
MARKETPLACE_SUBMIT_PER_HOUR=20
# Scheduler (durable jobs: platform jobs, hotel night audit, rent invoicing …). The worker is on by default (off in tests).
SCHEDULER_WORKER=true
SCHEDULER_POLL_MS=5000
SCHEDULER_LEASE_MS=120000
# attempts per run; retries wait RETRY_BASE_MS × 2^(attempt − 1), at most one hour
SCHEDULER_MAX_ATTEMPTS=5
SCHEDULER_RETRY_BASE_MS=30000
# renewal invoices are issued this many days before the next billing period
SCHEDULER_RENEWAL_LEAD_DAYS=7
# Requests per minute: sensitive routes (password, two-factor, Super Admin changes, exports) per person; webhooks per address
SENSITIVE_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_RATE_LIMIT_PER_MINUTE=1200
# Catalogue prices change only through a request approved by a second Super Admin (default: true in production)
CATALOGUE_PRICE_APPROVAL=
# How long a stopping server waits for requests and workers before it exits anyway
SHUTDOWN_TIMEOUT_MS=25000
# Public self-service sign-up and free trials (the trial policy itself is a database row the Super Admin changes)
SIGNUP_ENABLED=true
# sign-up requests per caller address per hour, and per e-mail address per day (also verification messages)
SIGNUP_PER_IP_PER_HOUR=10
SIGNUP_PER_EMAIL_PER_DAY=3
# the version of the PALTAS terms a sign-up must accept
SIGNUP_TERMS_VERSION=2026-10
# where verification links point (the front end's verification page)
APP_BASE_URL=http://127.0.0.1:8080

# Published, reviewed signup terms. Production registration also requires a connected email adapter.
SIGNUP_TERMS_URL=

# Self-service product release allowlist. Empty means no product may register, even if enabled.
SIGNUP_PRODUCTS=property
# public read-only signup options (GET /api/v1/public/signup-options): requests per minute per address, cache life
PUBLIC_READ_RATE_LIMIT_PER_MINUTE=120
PUBLIC_CACHE_SECONDS=300
# PALTAS's own e-mail (verification, password reset, trial notices). none, or a provider without its credentials =
# messages are recorded only, never sent (the server still starts; production sign-up stays closed).
#   smtp: e.g. Gmail — smtp.gmail.com, 465 (implicit TLS) or 587 (STARTTLS), the account and a Google "App password".
#         SMTP reports acceptance only ("sent (accepted by mail server)"), never delivery.
#   resend | postmark | sendgrid: RESEND_API_KEY | POSTMARK_SERVER_TOKEN | SENDGRID_API_KEY, sending from a verified
#         domain; PLATFORM_EMAIL_WEBHOOK_SECRET verifies POST /api/v1/webhooks/email/<provider> (Resend whsec_…,
#         Postmark "user:password" basic auth, SendGrid verification public key).
# PLATFORM_EMAIL_FROM is the one sending mailbox; its address is also the reply-to and help contact in PALTAS messages.
PLATFORM_EMAIL_PROVIDER=none
PLATFORM_EMAIL_FROM="PALTAS <supportpaltas@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=supportpaltas@gmail.com
SMTP_PASSWORD=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
PLATFORM_EMAIL_WEBHOOK_SECRET=
# tests only (a local fake provider); never set in production
PLATFORM_EMAIL_API_URL=
# Self-service password reset: link life in minutes, requests per caller address per hour, per account per hour
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_PER_IP_PER_HOUR=20
PASSWORD_RESET_PER_ACCOUNT_PER_HOUR=3

# Optional shared PALTAS SaaS subscription checkout (all products).
# OFF until approved recurring prices, test checkout and signed webhooks pass staging.
STRIPE_ENABLED=false
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# An array of approved regional catalogue mappings; amount/currency/period are validated against the invoice.
# Example only, never copy fake price ids into a live deployment:
STRIPE_PRICE_MAP=[]
