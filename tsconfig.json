/* ======================================================================
 * THE MIGRATION CONFIGURATION, AND WHAT EACH LINE IS PROTECTING.
 *
 * This repository is JavaScript today. Every setting below is chosen so
 * that it keeps working unchanged while files move across one at a time —
 * and so that the day a file becomes .ts the compiler is ALREADY strict,
 * rather than being tightened later, when tightening means a hundred errors
 * at once and the temptation to reach for `any`.
 * ====================================================================== */
{
  "compilerOptions": {
    /* Node 22 in the image, Node 24 in CI. ES2023 is comfortably inside both
       and leaves BigInt literals alone, rather than downlevelling money
       arithmetic into something that no longer looks like the source. */
    "target": "ES2023",
    "lib": ["ES2023"],

    /* nodenext, because package.json says `type: module` and every import in
       this service already carries its .js extension. Anything else rewrites
       those specifiers and breaks the resolution the runtime actually does. */
    "module": "nodenext",
    "moduleResolution": "nodenext",

    /* PINNED, and not an accident.
     *
     * src/domain/market.js reads contract/market-config.js at IMPORT time,
     * resolved as HERE/../../ — so dist/domain/market.js must sit at exactly
     * the depth src/domain/market.js does. `rootDir: src` keeps that true.
     * Set it to "." and the output becomes dist/src/domain/market.js, the
     * path resolves one level wrong, and the container does not start at all.
     * test/build.test.js asserts this. */
    "rootDir": "src",
    "outDir": "dist",

    /* OFF, now that src/ holds no JavaScript at all.
     *
     * It was on for the migration so a half-converted tree compiled and
     * emitted. Leaving it on afterwards means a .js file added to src/ would
     * be accepted silently and never type-checked, which is exactly the
     * quiet hole this migration existed to close. test/build.test.js counts
     * the source files, so a .js appearing in src/ now fails to compile
     * rather than passing unexamined. */
    "allowJs": false,

    /* HOW A HALF-CONVERTED TREE ACTUALLY RUNS.
     *
     * Node does not map `./errors.js` to `errors.ts`. Verified: it throws
     * ERR_MODULE_NOT_FOUND, from a .js importer and from a .ts one alike. So
     * during the migration a specifier must name the file that really exists —
     * `./errors.ts` — or nothing runs unbuilt, and the test suite runs unbuilt
     * by design.
     *
     * But a COMPILED tree has no .ts files, so the emitted specifier must say
     * `.js`. These two options are the purpose-built answer: source says
     * `./errors.ts`, tsc emits `./errors.js`.
     *
     * Verified here that it rewrites the specifier in .js importers too, which
     * is what makes a half-converted tree possible at all — the 28 files that
     * import errors are mostly still JavaScript.
     *
     * test/imports.test.js proves every relative specifier resolves to a file
     * that exists, which is the failure this pair prevents. */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    /* On from the first day, before a single file is converted. A migration
     * that starts loose and tightens later is one that never tightens.
     *
     * ── exactOptionalPropertyTypes IS OFF, AND STAYS OFF ────────────────
     *
     * Measured against the finished tree: 41 errors, and every one of them is
     * against PRISMA'S GENERATED TYPES rather than against this codebase.
     * Prisma declares its arguments `field?: T` without `| undefined`, and the
     * idiom this service uses — `where.status = enumParam(...)`, which yields
     * undefined for a filter nobody sent — is precisely what the flag refuses.
     *
     * Turning it on would mean rewriting 41 assignments into conditional
     * spreads: more code, no bug found, and a real chance of introducing one
     * in a `where` clause. It is not practical against a generated client, and
     * "where practical" is the bar. If Prisma ever emits `| undefined`, this
     * becomes a one-line change and the note can go. */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* ── ON, AND IT PAID FOR ITSELF ────────────────────────────────────
     *
     * `CLASS_RANK` was `Record<string, number>`, so `CLASS_RANK.PUBLIC` — a
     * constant declared three lines above — read back as possibly missing.
     * Naming the six rungs as a union is both more honest and what a
     * classification ladder should have said from the start; a class that
     * came from a column is now checked by `isLadderClass()` before it is
     * ranked, which it was not before.
     *
     * The rest was `req.params.id`, 66 times. Express types params as
     * `{ [key: string]: string }`, so every one read as possibly undefined —
     * never true on a route that declares `:id`. They go through `param()`
     * in http/request.ts, which names the invariant once and fails with a
     * sentence if a route is renamed while a handler still reads the old
     * parameter. That beats passing undefined into a `where` clause. */
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* Node runs .ts test files directly by stripping types, which is what
     * keeps the test suite free of a build step. Stripping refuses anything
     * that is not erasable — no TS enum, no namespace, no parameter properties
     * — so the compiler refuses them too and the failure is a type error at
     * author time rather than a runtime refusal in CI.
     *
     * Verified on this machine: `enum Colour { Red }` under strip-only mode
     * gives "TypeScript enum is not supported in strip-only mode". */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* Prisma's generated index.d.ts is 370,961 lines. Checking it on every
       build costs minutes and finds nothing this service can act on. */
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": false,
    "resolveJsonModule": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "scripts", "prisma"]
}
