{
  "name": "paltas-backend",
  "version": "0.1.0",
  "private": true,
  "description": "The PALTAS API. Sessions, organizations and the promotion workflow, built to the contract in the frontend's backend.md.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "prisma migrate deploy && node dist/server.js",
    "dev": "node --watch src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "test": "node scripts/test.mjs",
    "verify": "prisma generate && npm run typecheck && node scripts/test.mjs",
    "check": "prisma validate && prisma format --check"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "jose": "5.9.6",
    "pg": "^8.13.1",
    "prisma": "6.1.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
