{
  "name": "paltas-backend",
  "version": "0.1.0",
  "private": true,
  "description": "The PALTAS API. Sessions, organizations and the promotion workflow, built to the contract in the frontend's backend.md.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "prisma migrate deploy && node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "test": "node scripts/test.mjs",
    "verify": "prisma generate && node scripts/test.mjs",
    "check": "prisma validate && prisma format --check"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "jose": "5.9.6",
    "pg": "^8.13.1",
    "prisma": "6.1.0"
  }
}
