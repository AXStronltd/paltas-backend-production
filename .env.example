# ======================================================================
# PALTAS API — the settings this service needs.
#
# Copy to .env for local work. NEVER commit .env — .gitignore already
# excludes it, and CI fails the build if one ever appears.
#
# NO SECRET IN THIS FILE HAS A VALUE. The only lines filled in are the two
# public URLs and a number of days, because guessing those wrong is the most
# common first-deploy mistake and they are not secret. Everything that IS
# secret is a bare name, so copying this file can never leak anything.
#
# On Render these go in: your service → Environment. Not in a file.
# ======================================================================

# --- the database -----------------------------------------------------
# On Render, use the INTERNAL connection string of the Postgres instance
# THIS service owns.
#
# IMPORTANT, AND THE REASON THIS COMMENT IS LONG: do not point this at the
# existing `paltas-db`. That database's seed data (58 listings, 12
# photographs) has an unresolved provenance question, and `npm start` runs
# `prisma migrate deploy`. Pointing this at it would run migrations against
# it, which is the one thing that must not happen until that question is
# settled. Create a new Postgres instance for this service.
DATABASE_URL=

# --- sessions ---------------------------------------------------------
# A long random string. Generate one with:   openssl rand -base64 48
# Changing it does not invalidate sessions (those live in the database);
# it is here so that anything later signed with it has a real secret.
SESSION_SECRET=

# --- Google sign-in ---------------------------------------------------
# Google Cloud console → APIs & Services → Credentials →
#   Create credentials → OAuth client ID → Web application
#
# Under "Authorised redirect URIs" add EXACTLY, with no trailing slash:
#   https://<your PUBLIC_URL>/auth/google/callback
#
# Google compares that string character for character. A mismatch produces
# `redirect_uri_mismatch`, and it is the single most common reason a first
# deployment cannot sign anybody in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- where things live ------------------------------------------------
# This API's own public address.
PUBLIC_URL=https://api.paltas.io
# The frontend. Sign-in returns the person here, and this origin is
# allowed to call the API with credentials.
APP_URL=https://paltas.io

# --- optional ---------------------------------------------------------
# Extra browser origins allowed to call this API, comma separated.
# A staging site, or http://127.0.0.1:8899 when testing the static
# frontend locally.
ALLOWED_ORIGINS=

# How long a sign-in lasts, in days. Default 14.
SESSION_DAYS=14

# Set to 1 ONLY for local http testing. It turns off Secure on the session
# cookie, which means the session would travel in clear over a network.
# Never set this on a deployed service.
# INSECURE_COOKIES=1

# Set to 1 to log every SQL query. Useful once, noisy always.
# PRISMA_LOG=1
