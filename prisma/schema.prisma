// ============================================ SECURITY MANAGEMENT
//
// A first-class product, not an add-on to property. It guards offices,
// hotels, festivals, schools, hospitals, warehouses and building sites —
// which is why every model here hangs off Site rather than off Building.
//
// The chain the product is built on:
//   Organization → Site → Zone → Host(Party) → Visitor/Vehicle → Pass

model Zone {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
