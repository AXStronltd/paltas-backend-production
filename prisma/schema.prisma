// ======================================================================
// THE PALTAS DATA MODEL.
//
// Every enum below is copied from `assets/session.js` in the frontend, value
// for value. That is deliberate and it is the whole point: the session object
// this API returns is handed to the frontend untranslated, so a value the
// database can hold that the frontend cannot read is a bug the schema should
// have prevented.
//
// The chain the frontend reads, in order:
//
//   USER  →  ORGANIZATION  →  SUBSCRIPTION  →  ENTITLEMENT[]
//                          →  MEMBERSHIP(role, scope)  →  WORKSPACE
//
//   Entitlement decides which CONSOLE exists.   Role decides what is INSIDE it.
//   They are different questions and this schema keeps them in different tables.
// ======================================================================

generator client {
  provider = "prisma-client-js"
  // No preview features, and `driverAdapters` in particular is deliberately
  // absent — see the long note in src/db.js. It was tried twice and taken
  // back out both times, for the same reason: it cannot be exercised where
  // this was written, and the path every request takes is the wrong place
  // for code nobody has run.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

/// The five products. PLATFORM is PALTAS's own staff console.
enum Product {
  PROPERTY_MANAGEMENT
  AGENT_HOST
  HOTEL_MANAGEMENT
  SECURITY_MANAGEMENT
  GUEST_PORTAL
  PLATFORM
}

/// TRIALING, ACTIVE and PAST_DUE all open the console. The wall is CANCELED
/// and EXPIRED — and even then nothing is deleted.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Verification NEVER closes a console. It restricts `publish` and `payout`
/// and nothing else — see lib/rights.js, which is the only place that decides.
enum VerificationStatus {
  NOT_STARTED
  PENDING
  ADDITIONAL_INFORMATION_REQUIRED
  REJECTED
  COMPLETE
}

/// A role is a job. Every value here exists in the frontend's ROLES table.
enum Role {
  OWNER
  MANAGER
  OPERATIONS
  HOST
  LEASING
  PROMO_CONTRIBUTOR
  FINANCE
  RECEPTIONIST
  SECURITY_MANAGER
  GM
  FRONT_DESK
  HOUSEKEEPING
  ENGINEERING
  FNB
  GUEST
  GUARD
  // PALTAS staff. Three roles, and the split between them is the product's
  // only real guarantee about what reaches the public homepage.
  MARKETING
  COMPLIANCE
  PUBLISHER
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// The promotion workflow. Twelve states, and exactly one of them is public —
/// see the `PUBLIC_STATES` constant in src/lib/promotions.js, which is the one
/// place that decides and the only thing GET /promotions/public consults.
enum PromotionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  MARKETING_APPROVED
  FINAL_APPROVED
  SCHEDULED
  PUBLISHED
  PAUSED
  EXPIRED
  REJECTED
}

// ---------------------------------------------------------------- people

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  phone     String   @default("")
  /// Google's stable subject claim. NOT the email: people change emails, and
  /// Google's `sub` is the only identifier Google promises never to reuse.
  googleSub String?  @unique
  picture   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  sessions        Session[]
  /// The company records that are this person — see Party.userId. A guest
  /// staying at two hotels is two parties and one user.
  parties         Party[]
  /**
   * An investor register entry this person signs in as. Additive.
   */
  investors       Investor[]
  /// Hotel bookings this person made through a licensed supplier. Theirs, not
  /// an operator's — see SupplierBooking.
  stayBookings    SupplierBooking[]
  promotions      Promotion[]       @relation("PromotionAuthor")
  events          PromotionEvent[]
  /// What this person did. SetNull on delete: the record outlives the account.
  auditEvents     AuditEvent[]
  workOrderEvents WorkOrderEvent[]
  incidentEvents  IncidentEvent[]

  invitationsSent     Invitation[] @relation("InvitationsSent")
  invitationsAccepted Invitation[] @relation("InvitationsAccepted")

  /**
   * ---- Property DNA. A person's standing on a property is not their job. ----
   */
  propertyEvents    PropertyTimelineEvent[]
  propertyRelations PropertyRelationship[]
  successionOpened  SuccessionCase[]        @relation("SuccessionOpener")
  successionShares  SuccessionBeneficiary[]
  successionSteps   SuccessionStep[]
  propertyScans     PropertyScan[]

  @@index([googleSub])
}

/// A signed-in browser. Rows here are the reason a sign-out is real: deleting
/// the row ends the session everywhere, which a self-contained JWT cannot do.
model Session {
  id        String        @id @default(cuid())
  /// The cookie holds a random token; this column holds its SHA-256. A leaked
  /// database backup is then not a pile of working session cookies.
  tokenHash String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which organization this browser is currently acting for. A person can
  /// belong to several; the session remembers which one they chose.
  ///
  /// A REFERENCE, not ownership — a session belongs to a USER. It is a real
  /// foreign key so that deleting a company cannot leave live sessions
  /// pointing at an organization that no longer exists; SetNull drops the
  /// pointer and the next read falls back to the person's first membership.
  ///
  /// Nothing trusts this value on its own. sessionView() re-derives the
  /// organization from the person's memberships every time, so a stale or
  /// revoked orgId grants nothing — this constraint removes a dangling
  /// reference, it is not what makes the session safe.
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  userAgent String        @default("")
  ip        String        @default("")
  expiresAt DateTime
  createdAt DateTime      @default(now())
  /// Sessions ARE updated — switching organization writes to this row — so
  /// when that last happened is worth knowing when a sign-in is disputed.
  updatedAt DateTime      @default(now()) @updatedAt

  @@index([userId])
  @@index([expiresAt])
  /**
   * DRIFT, CORRECTED.
   * Migration 20260911160000_session_org_fk created this index and the schema
   * never declared it, so `prisma migrate diff` wanted to DROP it — a schema
   * change arriving as a side effect of an unrelated migration.
   * It is declared rather than dropped because it should be there: `org` is a
   * foreign key with onDelete: SetNull, and without an index on it, deleting a
   * company scans every session row in the service to find the handful that
   * point at it.
   */
  @@index([orgId])
}

// --------------------------------------------------------- the company

model Organization {
  id        String    @id @default(cuid())
  name      String
  /// Every organization that exists today is a CUSTOMER and the default keeps
  /// it that way, so the migration has nothing to guess. A public authority
  /// is made one through AuthorityProfile, which carries its own verification.
  kind      OrgKind   @default(CUSTOMER)
  country   String    @default("ke")
  city      String    @default("")
  size      String    @default("")
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subscription Subscription?
  /// The Stripe Connect account this company collects through, if it has one.
  connected    ConnectedAccount?
  verification Verification?
  workspace    Workspace?
  entitlements Entitlement[]
  memberships  Membership[]
  promotions   Promotion[]
  /// Sessions currently acting for this company. SetNull on delete — see the
  /// comment on Session.orgId.
  sessions     Session[]

  /// ---- the shared spine ----
  sites       Site[]
  buildings   Building[]
  units       Unit[]
  parties     Party[]
  documents   Document[]
  auditEvents AuditEvent[]

  /// ---- property & development ----
  leases           Lease[]
  projects         Project[]
  ledgerAccounts   LedgerAccount[]
  journalEntries   JournalEntry[]
  journalLines     JournalLine[]
  financialPeriods FinancialPeriod[]
  investors        Investor[]
  distributions    Distribution[]
  capitalCalls     CapitalCall[]

  /**
   * Tokenised investment. Additive: see the INVESTMENTS block at the end.
   */
  issuerProfile    IssuerProfile?
  offerings        Offering[]
  investorProfiles InvestorProfile[]
  investmentOrders InvestmentOrder[]
  tokenHoldings    TokenHolding[]
  tokenEvents      TokenEvent[]
  workOrders       WorkOrder[]
  assets           Asset[]

  /// ---- hotel ----
  rooms         Room[]
  reservations  Reservation[]
  folios        Folio[]
  hotelServices HotelService[]
  guestRequests GuestRequest[]
  channels      Channel[]
  rateRules     RateRule[]
  groupBookings GroupBooking[]
  auditTasks    NightAuditTask[]

  /// ---- agent & host ----
  listings      Listing[]
  leads         Lead[]
  viewings      Viewing[]
  deals         Deal[]
  conversations Conversation[]
  messages      Message[]
  opsTasks      OpsTask[]
  pricingRules  PricingRule[]

  /// ---- security ----
  zones          Zone[]
  visits         Visit[]
  passes         Pass[]
  vehicles       Vehicle[]
  incidents      Incident[]
  guardShifts    GuardShift[]
  patrols        Patrol[]
  deliveries     Delivery[]
  cameras        Camera[]
  guardTasks     GuardTask[]
  emergencyPlans EmergencyPlan[]

  /// ---- money ----
  invoices Invoice[]
  payments Payment[]
  expenses Expense[]
  payouts  Payout[]

  /**
   * Held BY the platform, ABOUT this company.
   */
  moderationItems ModerationItem[]
  complianceCases ComplianceCase[]
  invitations     Invitation[]

  /**
   * ---- Property DNA. The identity layer the products share. ----
   */
  propertyDna       PropertyDna[]
  propertyTimeline  PropertyTimelineEvent[]
  propertyRelations PropertyRelationship[]
  propertyOwnership PropertyOwnershipRecord[]
  propertyHeritage  PropertyHeritageRecord[]
  successionCases   SuccessionCase[]
  successionParties SuccessionBeneficiary[]
  successionSteps   SuccessionStep[]
  propertyScans     PropertyScan[]
  propertyFindings  PropertyScanFinding[]

  /**
   * ---- The authority layer. What the state records about a property. ----
   */
  authorityProfile  AuthorityProfile?
  jurisdictions     Jurisdiction[]
  parcels           Parcel[]
  propertyParcels   PropertyParcel[]
  authorityRecords  PropertyAuthorityRecord[]
  authorityRequests AuthorityRequest[]
  Contract          Contract[]
  ProjectPhase      ProjectPhase[]
  Milestone         Milestone[]
}

model Subscription {
  id        String             @id @default(cuid())
  orgId     String             @unique
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(TRIALING)
  plan      String             @default("")
  planKey   String             @default("")
  trialDays Int                @default(30)
  seats     Int                @default(1)
  trialEnds DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Entitlement {
  id      String            @id @default(cuid())
  orgId   String
  org     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product Product
  status  EntitlementStatus @default(ACTIVE)
  since   DateTime          @default(now())

  /// One entitlement per product per company. An account holding both "host"
  /// and "agent" holds ONE product, and counting it twice sent that customer
  /// to a workspace door offering the same console twice.
  @@unique([orgId, product])
}

/// An invitation to join a company, carried by a link.
///
/// THE TOKEN IS NOT STORED. Only its SHA-256 is, exactly as Session does with
/// its own — a link is a credential, and a database copy of every live
/// credential is a database worth stealing. The plaintext exists once, in the
/// response that creates it, and is never recoverable afterwards. An owner who
/// loses the link revokes it and sends another.
///
/// BOUND TO AN EMAIL, deliberately. Accepting requires being signed in as the
/// address the invitation names. Without that, a link forwarded to the wrong
/// WhatsApp group is a stranger inside the company — and a link is exactly the
/// kind of thing that gets forwarded.
model Invitation {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Lower-cased on the way in, so "Sam@x.com" and "sam@x.com" are one person.
  email     String
  role      Role
  /// What the invited person may see, copied onto the Membership on accept.
  scope     Json   @default("{\"all\": true}")
  tokenHash String @unique

  invitedById String?
  invitedBy   User?   @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  expiresAt    DateTime
  /// Set once, on accept. Its presence is what makes an invitation single-use.
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("InvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  /// Withdrawn by the company before it was taken up.
  revokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([email])
}

model Membership {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role   Role         @default(OWNER)
  /// What this person may see inside the company, as JSON: `{"all": true}` or
  /// `{"sites": ["ST-1", "ST-3"]}`. A guard on two gates is not a guard on
  /// every gate, and the frontend already reads this shape.
  scope  Json         @default("{\"all\": true}")

  createdAt DateTime @default(now())
  /// Role changes are edits to this row, so when it last changed is the
  /// answer to "when was this person promoted".
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
}

model Verification {
  id        String             @id @default(cuid())
  orgId     String             @unique
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status    VerificationStatus @default(NOT_STARTED)
  /// `[{ kind, name, uploadedAt, status }]`. File bytes are not in this
  /// database — this is the register of what was supplied, not the store.
  documents Json               @default("[]")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Workspace {
  id        String       @id @default(cuid())
  orgId     String       @unique
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status    String       @default("ACTIVE")
  /// Which console this company lands in when several are entitled.
  preferred String       @default("")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// --------------------------------------------------------- promotions

model Promotion {
  id    String       @id @default(cuid())
  /// The human-facing reference, PR-0001. Sequential per deployment, and what
  /// a customer quotes when they ring up.
  ref   String       @unique
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title       String @default("")
  headline    String @default("")
  subtitle    String @default("")
  description String @default("")
  type        String @default("")
  offer       String @default("")

  startDate DateTime?
  endDate   DateTime?

  destination    String @default("")
  ctaLabel       String @default("")
  ctaDestination String @default("")
  terms          String @default("")

  image     String @default("")
  /// `{ name, w, h, mb, busy }` — the properties the creative check reads.
  imageMeta Json?

  placement String @default("discover")
  audience  String @default("all")
  language  String @default("en")
  priority  Int    @default(50)

  /// ---- market targeting -------------------------------------------------
  /// All optional, all NARROWING. A promotion carrying none of them is
  /// global, which is the right default because most campaigns are.
  ///
  /// Null, never an empty array: "I did not target this" and "I targeted
  /// nothing" are different statements, and the second one read as a filter
  /// hides the promotion everywhere.
  countries        String[]
  excludeCountries String[]
  regions          String[]
  cities           String[]
  currencies       String[]
  languages        String[]
  /// The strongest two, and the ones worth reaching for. Naming Kenya is a
  /// guess that M-Pesa is on there; asking whether M-Pesa resolves is the
  /// fact, and it stays true the day a provider is switched off.
  requiresPayment  String?
  requiresService  String?
  requiresProduct  String?

  status    PromotionStatus @default(DRAFT)
  /// True when the assistant drafted any of the copy. Kept because a reviewer
  /// is entitled to know, and because the customer was told it would be.
  aiDrafted Boolean         @default(false)

  createdById String
  createdBy   User   @relation("PromotionAuthor", fields: [createdById], references: [id])
  reviewedBy  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PromotionEvent[]

  /// The index GET /promotions/public actually uses. It is the only query in
  /// the product an anonymous visitor can cause, so it is the one that has to
  /// stay fast when there are a hundred thousand rows.
  @@index([status, startDate, endDate])
  @@index([orgId, status])
}

/// Every decision, with who and why. Append-only: nothing here is ever edited
/// or removed, because "what exactly did PALTAS ask me for, and when" is a
/// question a customer is entitled to a straight answer to.
model PromotionEvent {
  id          String          @id @default(cuid())
  promotionId String
  promotion   Promotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  /// "created", "submitted", "changes requested", "published", …
  what        String
  /// The message shown to the customer. On a changes-requested event this is
  /// the ONLY thing they see, which is why the API refuses an empty one.
  why         String          @default("")
  /// The state the promotion was left in by this event.
  status      PromotionStatus
  byId        String?
  by          User?           @relation(fields: [byId], references: [id], onDelete: SetNull)
  /// Kept as text as well as a relation: a reviewer who later leaves the
  /// company must not erase the fact that they made the decision.
  byName      String          @default("")
  at          DateTime        @default(now())

  @@index([promotionId, at])
}

/// One row, holding the promotion counter. A sequence in its own table rather
/// than counting existing rows: two people creating a promotion in the same
/// second must not both be told they made PR-0007.
model Counter {
  name  String @id
  value Int    @default(0)
}

// ======================================================================
// ======================================================================
//
//                     THE PRODUCTS
//
// Everything above this line is the platform spine: who signed in, which
// company they act for, what that company bought. Everything below is the
// work those companies actually do.
//
// FOUR RULES HOLD FOR EVERY MODEL BELOW, WITHOUT EXCEPTION:
//
//   1. `orgId` + `onDelete: Cascade` + an index on it. One database holds
//      many companies' businesses; a model that cannot be scoped to one is
//      a model that leaks. test/tenancy.test.js fails the build otherwise.
//
//   2. Money is an INTEGER of minor units (cents, not dollars) plus a
//      currency code. Never Float. 0.1 + 0.2 is not 0.3 in binary floating
//      point, and a rent roll that is wrong by a cent per row is wrong by
//      real money at the bottom of the page.
//
//   3. Anything a person can be held to — a decision, a state change, a
//      sum — is append-only history, not an overwritten field.
//
//   4. No file bytes. Documents carry a provider reference and a checksum;
//      the bytes live in object storage. A passport scan in a Postgres row
//      ends up in every backup, every replica and every dump.
//
// ======================================================================

/// Money, everywhere. Minor units — 125050 is KES 1,250.50.
/// Kept as a repeated pair rather than a shared type because Prisma has no
/// composite scalar, and a comment is cheaper than getting it wrong.

/// WHAT A GUEST ASKED FOR.
///
/// One table for the four things the guest portal lets somebody do: order a
/// service, book the airport transfer, report a problem, and ask a question.
/// They are the same shape — a request against a stay, with a state and a
/// reply — so they are one table with a `kind` rather than four that drift.
///
/// NOT A WorkOrder, DELIBERATELY. A work order is the company's internal job,
/// raised by staff and assigned to staff. "Could I have more towels" is not
/// that — and a guest must never be able to read the company's work queue to
/// find out what else is broken in the building.
model GuestRequest {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Which stay it belongs to. Required: a request with no stay has nobody to
  /// bill it to and nowhere to deliver it.
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  /// Who asked — the guest's own Party row. This is how a guest's requests are
  /// found without trusting anything the browser said about who they are.
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  kind   GuestRequestKind
  detail String             @default("")
  /// Free text from the guest — a time, a room number, a preference.
  note   String             @default("")
  status GuestRequestStatus @default(OPEN)

  /// What the hotel said back. On a closed request it is the only thing the
  /// guest sees, which is why an empty one reads badly.
  response   String    @default("")
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([reservationId])
  @@index([partyId])
}

enum GuestRequestKind {
  SERVICE
  TRANSFER
  ISSUE
  QUESTION
  /// A guest ASKS to check in or out. They cannot do it themselves: the room
  /// has to be ready, the identity seen and the payment authorised, and all
  /// three are the property's call. The portal raises the request; staff move
  /// the reservation. Calling it CHECK_IN rather than CHECKED_IN is the whole
  /// distinction.
  CHECK_IN
  CHECK_OUT
}

enum GuestRequestStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  DONE
  DECLINED
  CANCELLED
}

// ---------------------------------------------------------------- shared

/// WHERE. A site is the physical thing a company operates: an estate, a
/// tower, a hotel, a festival ground, a building site.
///
/// Shared deliberately by Property, Security, Community and Hotel. A hotel
/// that is also a guarded site is ONE site with two products looking at it,
/// not two rows that drift apart.
model Site {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  kind      SiteKind @default(RESIDENTIAL)
  /// Free text on purpose: addresses are not a solved problem globally, and
  /// a rigid schema for them locks out half the markets PALTAS wants.
  address   String   @default("")
  city      String   @default("")
  /// How many units the site holds, and what it is worth in minor units.
  /// Both come straight off the `portfolio` screen, which shows them.
  unitCount Int      @default(0)
  value     BigInt   @default(0)
  country   String   @default("")
  lat       Float?
  lng       Float?
  note      String   @default("")
  status    String   @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings     Building[]
  zones         Zone[]
  units         Unit[]
  visitors      Visit[]
  passes        Pass[]
  vehicles      Vehicle[]
  incidents     Incident[]
  patrols       Patrol[]
  guardShifts   GuardShift[]
  deliveries    Delivery[]
  workOrders    WorkOrder[]
  rooms         Room[]
  assets        Asset[]
  expenses      Expense[]
  projects      Project[]
  services      HotelService[]
  Camera        Camera[]
  GuardTask     GuardTask[]
  EmergencyPlan EmergencyPlan[]
  offerings     Offering[]

  /// Property DNA — one per site, created on demand.
  dna PropertyDna?

  /// The land this property stands on. Many-to-many, because one parcel can
  /// carry several properties and one development can span several parcels.
  parcels PropertyParcel[]

  @@index([orgId])
  @@index([orgId, kind])
}

enum SiteKind {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  LAND
  HOTEL
  OFFICE
  RETAIL
  INDUSTRIAL
  WAREHOUSE
  CONSTRUCTION
  FESTIVAL
  EVENT
  SCHOOL
  CAMPUS
  HOSPITAL
  ESTATE
  OTHER
}

model Building {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name      String
  city      String            @default("")
  floors    Int               @default(0)
  unitCount Int               @default(0)
  builtYear Int?
  condition BuildingCondition @default(GOOD)
  note      String            @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units Unit[]

  @@index([orgId])
  @@index([orgId, siteId])
}

enum BuildingCondition {
  GOOD
  FAIR
  NEEDS_WORK
}

/// A lettable or sellable space. The atom of Property Management.
model Unit {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId     String?
  site       Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  buildingId String?
  building   Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  /// The development this unit is part of, where it is one.
  ///
  /// A let flat belongs to a building; an off-plan apartment belongs to a
  /// PROJECT, and until this existed there was no way to say so — Project held
  /// only a COUNT of its units, so "which units are in Golden Park Phase 2"
  /// had no answer and "how many are sold" could not be asked.
  ///
  /// SetNull, like site and building: deleting a project must not take the
  /// flats with it.
  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// What the customer calls it — "A-204". Unique within a company only.
  ref          String
  /// The building as the person typed it. The relation above is the truth
  /// once a building is picked; this is what the `units` form collects.
  buildingName String     @default("")
  kind         UnitKind   @default(ONE_BED)
  floor        Int?
  sqm          Int?
  /// Asking rent per month, in minor units.
  rent         BigInt     @default(0)
  currency     String     @default("KES")
  status       UnitStatus @default(VACANT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leases      Lease[]
  listings    Listing[]
  OpsTask     OpsTask[]
  contracts   Contract[]
  PricingRule PricingRule[]
  offerings   Offering[]

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([orgId, status])
}

enum UnitKind {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  FOUR_BED
  SHOP
  OFFICE
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  NOTICE
  RESERVED
  OFF_MARKET
}

/// A person or company this organization deals with: a tenant, an owner, a
/// buyer, a guest, a contractor, a vendor.
///
/// ONE TABLE, NOT SIX. The same human is often a tenant in one building and
/// a buyer in another, and six tables means six half-truths about them.
model Party {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// ---- THE GUEST BRIDGE ----
  ///
  /// A Party is a record a COMPANY keeps — a tenant, an owner, a guest. A User
  /// is somebody who signs in. They were never connected, which is exactly why
  /// the guest portal had no way to know whose stay it was looking at: a guest
  /// holds no membership, so nothing in the session said which Party they are.
  ///
  /// NULLABLE, and usually null. Most parties never sign in — a vendor, a
  /// contractor, a tenant who pays by standing order. It is set only when a
  /// person proves they are this party by signing in.
  ///
  /// SetNull on delete: the company's record of the person outlives their
  /// account. Deleting a login must not delete a tenant.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name  String
  kind  PartyKind @default(CONTACT)
  email String    @default("")
  phone String    @default("")
  /// A resident lives in a unit and keeps cars. Text and a count, because
  /// the `s_residents` form collects both before a Unit record may exist.
  unit  String    @default("")
  cars  Int       @default(0)
  note  String    @default("")
  since DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leases       Lease[]        @relation("LeaseTenant")
  /// The unit sales this person is the buyer on.
  purchases    Contract[]     @relation("ContractBuyer")
  deals        Deal[]
  viewings     Viewing[]
  reservations Reservation[]
  invoices     Invoice[]
  visits       Visit[]        @relation("VisitHost")
  expenses     Expense[]      @relation("ExpenseVendor")
  payouts      Payout[]       @relation("PayoutBeneficiary")
  GuestRequest GuestRequest[]
  GroupBooking GroupBooking[]
  Conversation Conversation[]

  /// A named heir or family member on a property, before they are a user.
  propertyRelations PropertyRelationship[]

  @@index([orgId])
  @@index([orgId, kind])
  @@index([orgId, name])
  /// The guest portal's first query on every request: "which parties am I?"
  /// It is not allowed to be a table scan.
  @@index([userId])
}

enum PartyKind {
  OWNER
  BUYER
  TENANT
  GUEST
  CONTACT
  CONTRACTOR
  VENDOR
  STAFF
  RESIDENT
}

/// The register of documents. NO FILE BYTES — a provider reference only.
model Document {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  kind      DocumentKind @default(OTHER)
  /// Who or what it is about, as free text until it needs to be a relation.
  about     String       @default("")
  expiresAt DateTime?

  /// WHERE THE BYTES ACTUALLY ARE. A key in object storage, never content.
  storageKey String @default("")
  /// So a tampered or truncated file is detectable.
  checksum   String @default("")
  bytes      Int    @default(0)
  mimeType   String @default("")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  offeringDocuments OfferingDocument[]

  /// An official record this document evidences, when it is one.
  authorityRecords PropertyAuthorityRecord[]

  @@index([orgId])
  @@index([orgId, kind])
  @@index([orgId, expiresAt])
}

enum DocumentKind {
  OWNERSHIP
  LEASE
  COMPLIANCE
  INSURANCE
  TAX
  IDENTITY
  CONTRACT
  INVOICE
  OTHER
}

/// EVERY SENSITIVE OR ADMINISTRATIVE ACTION, APPEND-ONLY.
///
/// Not a log file — a table, queryable, scoped to a company, and never
/// updated or deleted. "Who changed this, when, and what did it say before"
/// is a question that gets asked exactly when nobody can answer it.
model AuditEvent {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// The person, kept as a relation AND a name: a leaver must not erase the
  /// record of what they did.
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String  @default("")

  action   String
  entity   String
  /// NOT a foreign key, and that is deliberate: this log records actions
  /// against every table, and the row it describes may since have been
  /// deleted — which is often the very action being recorded.
  entityId String @default("")
  /// What changed, as JSON. Never secrets, never document bytes.
  detail   Json?
  ip       String @default("")

  at DateTime @default(now())

  @@index([orgId, at])
  @@index([orgId, entity, entityId])
}

// ============================================ PROPERTY MANAGEMENT
//
// Portfolios, leases, rent and the money that follows. Development and
// Community share these tables rather than duplicating them — see Project
// and the `community` fields below, and AUDIT.md for why that is still an
// open product decision rather than a settled one.

model Lease {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unitId   String?
  unit     Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenantId String?
  tenant   Party?       @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: SetNull)

  ref        String
  /// Tenant and unit as typed. The relations above are the truth when set;
  /// these are what the `rentals` form collects before a tenant exists as
  /// a contact of its own.
  tenantName String      @default("")
  unitRef    String      @default("")
  /// Minor units.
  rent       BigInt      @default(0)
  currency   String      @default("KES")
  deposit    BigInt      @default(0)
  startsOn   DateTime?
  endsOn     DateTime?
  status     LeaseStatus @default(ACTIVE)
  note       String      @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([orgId, status])
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  NOTICE
  ENDED
  TERMINATED
}

/// A development project. Property Development lives here.
model Project {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name     String
  city     String       @default("")
  /// The unit count the project is PLANNED to deliver.
  ///
  /// Kept as a number even though `unitRows` now exists, because the two
  /// answer different questions: a tower is sold off-plan as "180 units" long
  /// before 180 Unit rows exist. Where rows exist they are the truth about
  /// what is built; this stays the target.
  units    Int          @default(0)
  dueOn    DateTime?
  stage    ProjectStage @default(PLANNING)
  /// How far the BUILDING has got, 0-100.
  ///
  /// The console has always drawn a construction-progress bar per project and
  /// there was no column behind it, so the adapter sent 0 and every bar read
  /// empty. `stage` is the nearest thing that existed and it is not the same
  /// question: a project can be in STRUCTURE at 20% or at 80%.
  built    Int          @default(0)
  /// Minor units.
  budget   BigInt       @default(0)
  spent    BigInt       @default(0)
  currency String       @default("KES")

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  CapitalCall CapitalCall[]
  offerings   Offering[]
  /// The units this project actually holds, as rows.
  unitRows    Unit[]
  /// The sale agreements written against it.
  contracts   Contract[]
  /// The stages of work this development is built in.
  phases      ProjectPhase[]
  /// Its dated commitments, whether or not they belong to a phase.
  milestones  Milestone[]

  @@index([orgId])
  @@index([orgId, stage])
}

/// A STAGE OF WORK INSIDE A DEVELOPMENT.
///
/// `Project.built` is a single percentage somebody types, and it was the only
/// structure a development had: a forty-storey tower and a pair of villas both
/// reduced to one number with nothing behind it. A phase is the unit a
/// construction programme is actually run in — foundations, superstructure,
/// fit-out — each with its own dates and its own progress.
///
/// WEIGHT, BECAUSE PHASES ARE NOT EQUAL. Ten per cent of the superstructure is
/// not ten per cent of the job. `weight` lets a project's real progress be the
/// weighted average of its phases; where no weights are set they count
/// equally and the average is the plain one.
model ProjectPhase {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId String
  /// Cascade, unlike most references here: a phase has no meaning without its
  /// project, and leaving orphans would make every progress figure wrong.
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  /// Where it sits in the programme. Two phases may share a position — work
  /// genuinely runs in parallel — so this orders rather than identifies.
  position Int         @default(0)
  status   PhaseStatus @default(NOT_STARTED)
  /// 0-100, this phase only.
  progress Int         @default(0)
  /// How much of the project this phase represents. 0 means "count it equally".
  weight   Int         @default(0)

  startsOn DateTime?
  endsOn   DateTime?
  note     String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]

  @@index([orgId])
  @@index([orgId, projectId])
  @@index([orgId, status])
}

/// A DATED COMMITMENT — the thing a developer is actually held to.
///
/// Attached to a project always, and to a phase where it belongs to one, so
/// "what is due this month across every development" and "what is left in the
/// fit-out" are both one query.
model Milestone {
  id        String        @id @default(cuid())
  orgId     String
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId   String?
  /// SetNull rather than Cascade: reorganising the programme must not delete
  /// the commitments that were made under it.
  phase     ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  name   String
  status MilestoneStatus @default(PENDING)
  dueOn  DateTime?
  /// When it was actually met. Kept apart from `dueOn` so a slipped milestone
  /// that was delivered still reads as slipped.
  doneOn DateTime?
  owner  String          @default("")
  note   String          @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, projectId])
  @@index([orgId, dueOn])
  @@index([orgId, status])
}

/// A SALE AGREEMENT FOR ONE UNIT.
///
/// The gap this fills was visible on screen. The Development console renders
/// "sold", "reserved" and "revenue banked" per project, and nothing in the
/// schema modelled a sale — so the frontend adapter hard-coded `sold: 0,
/// res: 0` with a comment saying the pipeline "this schema does not model",
/// and passed the construction BUDGET off as revenue banked. Every developer
/// saw 0 sold and a revenue figure that was really a cost.
///
/// It is deliberately NOT `Deal`. A Deal is an agency's commission pipeline —
/// it belongs to AGENT_HOST, has no unit, no deposit and no instalments, and
/// closing one earns a fee rather than selling a flat.
///
/// One contract, one unit. A buyer taking three apartments signs three, which
/// is how the trade works and what makes "how many units are sold" countable.
model Contract {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Per-company number — CON-2026-0041. Allocated by the framework; a caller
  /// may not choose one.
  ref String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// The unit being sold. Nullable because an off-plan reservation is often
  /// taken before the unit rows for a floor exist.
  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// The buyer, as a Party of kind BUYER. SetNull so deleting a contact does
  /// not delete the company's record of a sale.
  buyerId   String?
  buyer     Party?   @relation("ContractBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  /// Minor units, like every amount in this schema.
  price    BigInt @default(0)
  /// What has actually been received. This is the number a reservation is
  /// real because of.
  deposit  BigInt @default(0)
  currency String @default("KES")

  status      ContractStatus @default(RESERVED)
  /// How many instalments the balance is spread over. 0 means paid outright.
  instalments Int            @default(0)

  signedOn    DateTime?
  completedOn DateTime?
  note        String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, projectId])
}

/// Where a unit sale has got to.
///
/// RESERVED is money down and the unit off the market; SOLD is a signed
/// agreement; COMPLETED is handed over and paid. The three are kept apart
/// because the console counts them apart — "stock committed" is reserved AND
/// sold, while "revenue banked" is only what has actually been agreed.
///
/// CANCELLED rather than deleting the row: a reservation that fell through is
/// the reason a unit came back to the market, and erasing it loses that.
enum ContractStatus {
  RESERVED
  SOLD
  COMPLETED
  CANCELLED
}

/// Where a phase of a development has got to.
///
/// Deliberately smaller than ProjectStage: a project passes through planning,
/// approvals, groundwork and the rest ONCE, while a phase is simply not
/// started, running, done or stopped — and a tower has many phases running at
/// different times.
enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  ON_HOLD
}

/// A dated commitment inside a project.
///
/// MISSED is its own state rather than something a screen works out from the
/// date, because a milestone that slipped and was then delivered is a
/// different fact from one delivered on time, and an audit of a development
/// asks about exactly that.
enum MilestoneStatus {
  PENDING
  DONE
  MISSED
  CANCELLED
}

enum ProjectStage {
  PLANNING
  APPROVALS
  GROUNDWORK
  STRUCTURE
  FIT_OUT
  HANDOVER
  COMPLETE
  ON_HOLD
}

/// A resident's report, a tenant's complaint, an inspection finding — and
/// a hotel guest's broken air conditioner. ONE work queue, many sources,
/// because a building does not care which product raised the job.
model WorkOrder {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  ref        String
  title      String
  detail     String       @default("")
  kind       WorkKind     @default(OTHER)
  priority   WorkPriority @default(NORMAL)
  status     WorkStatus   @default(OPEN)
  /// Where — a unit ref, a room number, "lift lobby". Free text on purpose.
  place      String       @default("")
  /// Who it is with. A name until staff are modelled per product.
  assignee   String       @default("")
  /// Which department owns it. The guest portal routes on this.
  department String       @default("")

  raisedBy String    @default("")
  /// Set when it actually closed, not when somebody meant to close it.
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events WorkOrderEvent[]

  @@unique([orgId, ref])
  @@index([orgId, status])
  @@index([orgId, siteId])
}

enum WorkKind {
  WATER
  POWER
  LIFT
  SECURITY
  CLEANING
  NOISE
  PLUMBING
  HVAC
  APPLIANCE
  INTERNET
  STRUCTURAL
  HOUSEKEEPING
  FNB
  IT
  EMERGENCY
  OTHER
}

enum WorkPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum WorkStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

/// Append-only. What happened to a job, in order.
model WorkOrderEvent {
  id          String     @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  what        String
  why         String     @default("")
  status      WorkStatus
  byId        String?
  by          User?      @relation(fields: [byId], references: [id], onDelete: SetNull)
  /// Text as well as a relation: somebody who leaves must not erase the fact
  /// that they made the call. Same reason as PromotionEvent.byName.
  byName      String     @default("")
  at          DateTime   @default(now())

  @@index([workOrderId, at])
}

/// Lifts, generators, boilers, CCTV. What a maintenance schedule hangs off.
model Asset {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name          String
  kind          String    @default("")
  serial        String    @default("")
  place         String    @default("")
  installedOn   DateTime?
  servicedOn    DateTime?
  nextServiceOn DateTime?
  status        String    @default("OK")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, nextServiceOn])
}

// ================================================ HOTEL MANAGEMENT

model Room {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  number       String
  roomType     String           @default("Standard")
  floor        Int?
  /// Housekeeping state and physical condition are different questions and
  /// a single "status" column forces one to be lost.
  housekeeping RoomHousekeeping @default(CLEAN)
  condition    RoomCondition    @default(OK)
  occupied     Boolean          @default(false)
  outOfOrder   Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  @@unique([orgId, number])
  @@index([orgId, housekeeping])
}

enum RoomHousekeeping {
  CLEAN
  DIRTY
  IN_PROGRESS
  INSPECTED
}

enum RoomCondition {
  OK
  MINOR
  MAJOR
  OUT_OF_SERVICE
}

model Reservation {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roomId    String?
  room      Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  guestId   String?
  guest     Party?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  /// Which channel sold this stay. NULL means nobody attributed it — the
  /// front desk, or a reservation taken before the channel was linked.
  /// `source` is free text and stays as the human label; this is the join,
  /// because rolling revenue up by matching the channel "Booking.com" against
  /// the string "BOOKING" is how a commission figure comes to be confidently
  /// wrong.
  channelId String?
  channel   Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)

  ref        String
  guestName  String            @default("")
  /// Which property the stay is at, and the room as typed. A host booking
  /// names a property; a front desk types a room number before the room
  /// record is chosen.
  property   String            @default("")
  roomNumber String            @default("")
  roomType   String            @default("")
  arriveOn   DateTime?
  departOn   DateTime?
  nights     Int               @default(1)
  adults     Int               @default(1)
  children   Int               @default(0)
  eta        String            @default("")
  source     String            @default("DIRECT")
  status     ReservationStatus @default(CONFIRMED)
  /// Minor units. The quoted rate, not the running total — that is the folio.
  rate       BigInt            @default(0)
  currency   String            @default("KES")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folio         Folio?
  guestRequests GuestRequest[]

  @@unique([orgId, ref])
  @@index([orgId, status])
  @@index([orgId, arriveOn])
  @@index([orgId, channelId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  CANCELLED
}

/// The guest's running bill. Lines are append-only; the total is derived,
/// never stored — a stored total is a total that can disagree with its lines.
model Folio {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reservationId String       @unique
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  currency String    @default("KES")
  closed   Boolean   @default(false)
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines FolioLine[]

  @@index([orgId, closed])
}

model FolioLine {
  id      String @id @default(cuid())
  folioId String
  folio   Folio  @relation(fields: [folioId], references: [id], onDelete: Cascade)

  kind     String   @default("charge")
  detail   String   @default("")
  /// Minor units. Negative for a payment or a refund.
  amount   BigInt
  postedBy String   @default("")
  at       DateTime @default(now())

  @@index([folioId, at])
}

/// A restaurant, spa, gym — and the optional guest services a property
/// switches on, airport transfer included. Airport transfer is a SERVICE of
/// a hotel or host, never a PALTAS product of its own.
model HotelService {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name       String
  kind       String  @default("")
  opensAt    String  @default("")
  capacity   Int     @default(0)
  active     Boolean @default(true)
  /// Whether requesting it can put money on a folio. A service that charges
  /// must say so before a guest asks for it.
  chargeable Boolean @default(false)
  note       String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

/// A hotel booking a PALTAS user made through a licensed accommodation
/// supplier — LiteAPI today.
///
/// WHY THIS EXISTS WHEN SUPPLIER CONTENT IS NEVER STORED
///
/// It is not supplier content. A hotel's name, rates and photographs belong to
/// the wholesaler and are never persisted — see src/domain/supply.js. THIS is
/// PALTAS's own commercial record of a transaction one of its users made: who
/// booked, what they paid, and the references they need to arrive. A platform
/// that cannot tell a guest what they booked is not a platform they can use.
///
/// WHAT IT IS FOR, CONCRETELY
///
/// Ownership. Without a row saying whose a booking is, `GET /stays/:id` and the
/// cancel route can only ask "are you signed in?" — so anybody holding an id
/// could read a stranger's booking or cancel their holiday. That is why those
/// routes were sandbox-only until this table existed.
///
/// It is a SNAPSHOT, not a cache. Nothing re-reads it to decide what a room
/// costs; the supplier is always asked. If the two disagree the supplier is
/// right and the disagreement is the finding.
model SupplierBooking {
  id     String @id @default(cuid())
  /// Whose booking it is. The entire point of the table.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which supplier, and their identifiers for it.
  supplier  String
  /// The supplier's booking id — what a guest quotes.
  ///
  /// NULL until the booking is actually made. The row is created when the rate
  /// is HELD, before any money moves, so that the prebook pair below is durable
  /// the moment it exists rather than living only in a browser that may close.
  /// Postgres permits many NULLs in a unique index, so unbooked holds do not
  /// collide with each other.
  bookingId String?

  /// THE PREBOOK PAIR, persisted immediately.
  ///
  /// LiteAPI is explicit: "Save transactionId and prebookId together,
  /// immediately. Each prebook call generates a new pair, and they cannot be
  /// retrieved later." Lose them after the customer has paid and there is a
  /// charge with no booking and no way to look one up.
  ///
  /// `prebookId` is also the IDEMPOTENCY KEY: it is unique per supplier, so a
  /// retried book cannot become a second reservation.
  ///
  /// NULLABLE for one reason only: a row written before this column existed has
  /// no prebook, and adding a NOT NULL column without a default to a table that
  /// has rows is rejected by Postgres — which would fail the migration, abort
  /// `npm start`, and take the API down. A default of "" would be worse: two
  /// legacy rows would then collide on the unique index below.
  ///
  /// Every row this code writes sets it, and the index still guarantees one
  /// reservation per prebook for every value that is not null.
  prebookId             String?
  /// Sensitive in the sense that it settles money — but it is an identifier,
  /// not a credential. The Stripe CLIENT SECRET from the same prebook is never
  /// stored anywhere: it goes straight to the payment UI and nowhere else.
  transactionId         String  @default("")
  /// PENDING -> PAID -> CONFIRMED, or FAILED. Distinct from `status`, which is
  /// the supplier's view of the RESERVATION. A booking can be paid and not yet
  /// confirmed, and that gap is exactly where a guest loses money quietly.
  paymentStatus         String  @default("PENDING")
  /// Ours, generated per attempt. LiteAPI refuses a repeat, which is what stops
  /// a retried request becoming two bookings.
  clientReference       String  @default("")
  supplierBookingId     String  @default("")
  /// What the hotel's own desk recognises.
  hotelConfirmationCode String  @default("")

  /// Enough of the stay to show it back without asking the supplier again.
  hotelId   String    @default("")
  hotelName String    @default("")
  city      String    @default("")
  country   String    @default("")
  checkIn   DateTime?
  checkOut  DateTime?
  nights    Int       @default(1)

  /// Minor units, like every other amount in this service.
  price    BigInt @default(0)
  currency String @default("USD")

  /// CONFIRMED, CANCELLED, CANCELLED_WITH_CHARGES.
  status          String    @default("CONFIRMED")
  refundable      Boolean?
  cancelledAt     DateTime?
  /// What the cancellation actually cost, once it has happened. Nullable
  /// because "not cancelled" and "cancelled for nothing" are different.
  cancellationFee BigInt?
  refund          BigInt?

  /// A sandbox booking is not a booking — nobody is arriving. Stored so it can
  /// never be shown as confirmed travel.
  sandbox Boolean @default(false)

  /// Who is staying, as given to the hotel.
  holderName  String @default("")
  holderEmail String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per supplier booking, so a retry cannot record it twice.
  @@unique([supplier, bookingId])
  /// One row per PREBOOK. This is what makes booking idempotent: a second
  /// attempt against the same held rate finds this row instead of creating a
  /// second reservation the guest would be charged for once and hold twice.
  @@unique([supplier, prebookId])
  @@index([userId, createdAt])
}

