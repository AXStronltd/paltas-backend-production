// ================================================== MONEY
//
// THE ONLY PLACE MONEY IS DEFINED.
//
// Rent, a hotel folio, an agent's commission, a service charge and a
// contractor's bill are the same thing wearing different words, and a
// business that cannot ask "what is owed to me, across everything" has six
// half-answers instead of one number. So they share these tables.
//
// Four rules, and they are not negotiable:
//
//   1. AMOUNTS ARE INTEGER MINOR UNITS. 1500 KES is 150000. A Float here
//      would lose a cent per rounding and nobody would notice for a year.
//   2. EVERY AMOUNT CARRIES ITS CURRENCY. PALTAS is global; an invoice with
//      an amount and no currency is not a number, it is a guess.
//   3. TOTALS ARE STORED, NOT TRUSTED. The server recomputes from the lines
//      on every write. A total that arrives in a request body is discarded —
//      see the note on Invoice.total.
//   4. A PAYMENT IS NEVER DELETED. Money that moved and then vanished from
//      the record is the one failure a customer cannot forgive. Void it and
//      keep the row.

/// What somebody owes this organization.
model Invoice {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Who owes it. Nullable and SetNull: deleting a contact must not delete
  /// the record of what they were billed.
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)
  /// What it is for, when it is rent. Other sources hang off `source`.
  leaseId String?
  lease   Lease?  @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  /// Human-facing and unique per organization: INV-2026-0041.
  ref      String
  /// Where it came from: "lease", "folio", "deal", "service", "manual".
  source   String @default("manual")
  /// The id within that source. Not a foreign key — `source` decides which
  /// table it points into, and no one column can reference five of them.
  sourceId String @default("")

  /// MINOR UNITS, AND SERVER-COMPUTED. Sum of the lines, recomputed on every
  /// write. Never read from a request body: a client that can name its own
  /// total can name zero.
  total    BigInt @default(0)
  /// Sum of non-void payments. Also recomputed, never sent.
  paid     BigInt @default(0)
  currency String @default("KES")

  issuedOn DateTime?
  dueOn    DateTime?
  status   InvoiceStatus @default(DRAFT)
  note     String        @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines            InvoiceLine[]
  payments         Payment[]
  investmentOrders InvestmentOrder[]

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, dueOn])
  @@index([orgId, partyId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PART_PAID
  PAID
  OVERDUE
  VOID
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  detail    String
  quantity  Int    @default(1)
  /// Minor units, per unit of quantity.
  unitPrice BigInt @default(0)
  /// Basis points — 1600 is 16%. A percentage stored as a Float is the same
  /// rounding bug as a Float amount, one layer up.
  taxBps    Int    @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

/// Money that actually arrived.
///
/// SERVER-AUTHORITATIVE BY CONSTRUCTION. A row here is the service's own
/// record of a confirmed receipt. Nothing a browser says creates one: the
/// provider reference is what a reconciliation is checked against later.
model Payment {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// Minor units. Positive for a receipt, negative for a refund.
  amount      BigInt
  currency    String        @default("KES")
  method      PaymentMethod @default(CASH)
  /// The provider's own identifier — an M-Pesa code, a card charge id. The
  /// only thing that makes this row checkable against anybody else's ledger.
  reference   String        @default("")
  /// The payment processor's own id for this money — a Stripe PaymentIntent,
  /// `pi_...`. Empty for cash, a bank transfer or anything typed in by hand.
  ///
  /// Separate from `reference`, which is whatever a human wrote on the receipt.
  /// Overloading a free-text field with a machine identifier is how a
  /// reconciliation job starts matching on the wrong thing.
  providerRef String        @default("")
  receivedAt  DateTime      @default(now())
  receivedBy  String        @default("")

  /// A mistake is voided, never deleted. `voidReason` is required in the
  /// route, not here, so that the history explains itself.
  voided     Boolean   @default(false)
  voidReason String    @default("")
  voidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, method, reference])
  @@index([orgId, receivedAt])
  @@index([orgId, invoiceId])
}

/// A member company's own Stripe account, so it can charge its own customers.
///
/// WHOSE MONEY, AND WHY THAT DECIDES EVERYTHING ELSE
///
/// When a hotel on PALTAS charges a guest's folio, that money is the HOTEL'S.
/// PALTAS sells software; the hotel runs its own business, owns its own guests
/// and is the merchant of record. Stripe calls that the SaaS pattern, and it
/// settles the whole configuration:
///
///   dashboard        "full"    — these are independent businesses, not sellers
///                                inside a PALTAS storefront
///   fees_collector   "stripe"  — the company pays Stripe's fees directly
///   losses_collector "stripe"  — Stripe owns negative-balance liability
///   charges          DIRECT, with application_fee_amount for PALTAS's cut
///
/// The alternative — destination charges — would make PALTAS merchant of record
/// for every room, tenancy and invoice on the platform, and liable for every
/// chargeback on all of it. A guest disputing a room they did not like would be
/// arguing with PALTAS instead of the hotel that served them.
///
/// ACCOUNTS V2, AND WHY THERE IS NO `chargesEnabled` HERE
///
/// `charges_enabled` and `payouts_enabled` are deprecated v1 fields. Readiness
/// now lives at
///
///   configuration.merchant.capabilities.card_payments.status === "active"
///
/// so that is what is stored, verbatim, as Stripe last reported it. PALTAS
/// never infers it from "the onboarding form looked finished": Stripe decides
/// when a company has satisfied its verification, and a platform that guesses
/// will take money the company cannot be paid.
model ConnectedAccount {
  id    String       @id @default(cuid())
  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Which processor. One today; named so a second is a row, not a migration.
  provider  String @default("stripe")
  /// Stripe's `acct_...`. The only identifier that can charge anything.
  accountId String @unique

  /// The v2 capability status, verbatim: "active", "pending", "restricted",
  /// "inactive" or whatever Stripe adds next. Deliberately a string and not a
  /// boolean — "pending" and "restricted" are different situations for the
  /// company, and flattening them to false tells them nothing they can act on.
  cardPaymentsStatus String @default("inactive")
  /// Which Stripe dashboard the company gets. "full" for this platform.
  dashboard          String @default("full")

  /// What Stripe is still waiting for, comma separated, verbatim from the
  /// account's requirements. Shown to the company so "pending" is never a dead
  /// end they cannot do anything about.
  requirementsDue String @default("")
  /// Why Stripe restricted it, if it did. Their words, not a paraphrase.
  disabledReason  String @default("")

  country         String  @default("")
  defaultCurrency String  @default("")
  /// False for a test-mode account. A test account must never be shown as able
  /// to take real money.
  livemode        Boolean @default(false)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// When the status above was last confirmed against Stripe.
  lastSyncedAt DateTime?

  @@index([provider, accountId])
}

/// Every Stripe webhook this service has already processed.
///
/// Stripe delivers at least once, not exactly once — a retry after a timeout is
/// normal and expected. Without this table a redelivered
/// `payment_intent.succeeded` records the same money twice, and the company's
/// books say they were paid double.
///
/// The id IS Stripe's event id, so the uniqueness is the database's problem
/// rather than a race between two handlers.
model StripeEvent {
  /// Stripe's `evt_...`.
  id         String    @id
  type       String
  accountId  String    @default("")
  receivedAt DateTime  @default(now())
  /// Set once the handler finished. A row that exists but is unhandled means a
  /// delivery was received and something went wrong after — which is worth
  /// being able to find.
  handled    Boolean   @default(false)
  handledAt  DateTime?
  error      String    @default("")
  /// The row is written once on delivery and updated once when handling
  /// finishes, so it is not append-only.
  updatedAt  DateTime  @updatedAt

  @@index([type, receivedAt])
}

enum PaymentMethod {
  CASH
  BANK
  MPESA
  CARD
  CHEQUE
  OTHER
}

/// Money going out: a contractor's bill, a utility, a purchase.
model Expense {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId  String?
  site    Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  partyId String?
  party   Party?       @relation("ExpenseVendor", fields: [partyId], references: [id], onDelete: SetNull)

  detail      String
  category    String        @default("")
  /// Minor units.
  amount      BigInt        @default(0)
  currency    String        @default("KES")
  spentOn     DateTime?
  /// Whether it can be billed on to an owner or a tenant. A cost nobody
  /// marked as recoverable is one the landlord silently absorbed.
  recoverable Boolean       @default(false)
  status      ExpenseStatus @default(RECORDED)
  note        String        @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, spentOn])
  @@index([orgId, status])
}

enum ExpenseStatus {
  RECORDED
  APPROVED
  PAID
  REJECTED
}

/// What this organization owes an owner, a host or a partner after PALTAS
/// has taken its share. Requested here, confirmed elsewhere — creating a row
/// is not moving money, and this service does not move money.
model Payout {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  partyId String?
  party   Party?       @relation("PayoutBeneficiary", fields: [partyId], references: [id], onDelete: SetNull)

  /// Minor units, gross, then what was withheld, then what was sent.
  gross    BigInt @default(0)
  fees     BigInt @default(0)
  net      BigInt @default(0)
  currency String @default("KES")

  periodFrom DateTime?
  periodTo   DateTime?
  status     PayoutStatus @default(REQUESTED)
  reference  String       @default("")
  sentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([orgId, periodTo])
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  SENT
  FAILED
  CANCELLED
}

/**
 * ====================================================================== *
 * PROPERTY DEVELOPMENT.
 * Not a separate Product value, deliberately. `Project` has always been area
 * `property` / product PROPERTY_MANAGEMENT, and development is what a
 * property company does with a project. Adding PROPERTY_DEVELOPMENT to the
 * enum would mean every existing company stopped being entitled to screens it
 * uses today — removing working functionality in order to tidy a label.
 * ======================================================================
 */

model Investor {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  kind      InvestorKind   @default(INDIVIDUAL)
  units     Int            @default(0)
  /// Minor units, and BigInt: a development fund in KES passes INT4 long
  /// before it passes anything else.
  committed BigInt         @default(0)
  paid      BigInt         @default(0)
  currency  String         @default("KES")
  /// Basis points, so 9.2% is 920 and no yield is ever stored as a float.
  yieldBps  Int            @default(0)
  since     DateTime?
  status    InvestorStatus @default(ACTIVE)
  note      String         @default("")

  /// The PALTAS account this investor signs in with, when they have one. An
  /// investor may exist on a register before they ever create an account, and
  /// may never create one — so this is nullable, and it is the ONLY thing that
  /// lets "My Investments" find a person's own holdings. Never taken from a
  /// request: the same rule as Party.userId.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distributions    Distribution[]
  capitalCalls     CapitalCall[]
  investorProfile  InvestorProfile?
  investmentOrders InvestmentOrder[]
  tokenHoldings    TokenHolding[]

  @@index([orgId])
  @@index([orgId, name])
}

enum InvestorKind {
  INDIVIDUAL
  FUND
  COMPANY
  TRUST
  JOINT_VENTURE
}

enum InvestorStatus {
  PROSPECT
  ACTIVE
  EXITED
  SUSPENDED
}

model Distribution {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  period   String
  amount   BigInt             @default(0)
  currency String             @default("KES")
  status   DistributionStatus @default(DECLARED)
  paidOn   DateTime?
  note     String             @default("")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Which offering this distribution belongs to, when it belongs to one.
  /// Optional because Distribution predates offerings entirely and is still
  /// used for plain development distributions.
  ///
  /// SetNull, NOT Cascade: money that has been paid is a fact, and deleting
  /// the offering it related to must not delete the record of paying it.
  offering   Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  offeringId String?

  @@index([orgId])
  @@index([orgId, investorId])
}

enum DistributionStatus {
  DECLARED
  APPROVED
  PAID
  CANCELLED
}

model CapitalCall {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  ref      String
  amount   BigInt            @default(0)
  currency String            @default("KES")
  dueOn    DateTime?
  status   CapitalCallStatus @default(OUTSTANDING)
  note     String            @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([orgId, investorId])
}

enum CapitalCallStatus {
  DRAFT
  OUTSTANDING
  PART_PAID
  PAID
  OVERDUE
  CANCELLED
}

/**
 * ====================================================================== *
 * HOTEL MANAGEMENT — distribution, yield, groups, night audit.
 * ======================================================================
 */

model Channel {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name          String
  /// The one-letter badge the console already draws.
  mark          String        @default("")
  status        ChannelStatus @default(DISCONNECTED)
  /// How many of this property's room types are mapped, out of how many.
  mapped        Int           @default(0)
  total         Int           @default(0)
  /// Basis points: 15% commission is 1500.
  commissionBps Int           @default(0)
  lastSyncAt    DateTime?
  note          String        @default("")

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

enum ChannelStatus {
  DISCONNECTED
  LIVE
  PAUSED
  ERROR
}

model RateRule {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name     String
  /// The condition in the operator's own words. A rule ENGINE is a product
  /// decision nobody has made; recording the rule a human applies is not.
  whenText String  @default("")
  /// Signed basis points: +18% is 1800, -15% is -1500.
  moveBps  Int     @default(0)
  active   Boolean @default(true)
  /// How many nights this rule has actually moved. Counted, never guessed.
  hits     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model GroupBooking {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  ref      String
  orgName  String             @default("")
  event    String             @default("")
  rooms    Int                @default(0)
  nights   Int                @default(1)
  fromOn   DateTime?
  value    BigInt             @default(0)
  currency String             @default("KES")
  /// What has been settled, in MINOR UNITS — not a percentage. A percentage
  /// of a total that moves is how two screens come to disagree.
  paid     BigInt             @default(0)
  status   GroupBookingStatus @default(ENQUIRY)
  note     String             @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, ref])
  @@index([orgId])
}

enum GroupBookingStatus {
  ENQUIRY
  HELD
  CONFIRMED
  ARRIVED
  DEPARTED
  CANCELLED
}

model NightAuditTask {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title  String
  detail String    @default("")
  /// The night this checklist belongs to.
  runOn  DateTime
  done   Boolean   @default(false)
  doneAt DateTime?
  doneBy String    @default("")
  /// Keeps the checklist in the operator's order rather than alphabetical.
  seq    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, runOn])
}

/**
 * ====================================================================== *
 * SECURITY MANAGEMENT — devices, duties, emergency procedure.
 * ======================================================================
 */

model Camera {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name       String
  place      String       @default("")
  status     CameraStatus @default(ONLINE)
  /// Deliberately NO stream URL and NO credentials. A camera's address is a
  /// way into a customer's building, and listing which cameras exist and
  /// whether they answer needs neither.
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

enum CameraStatus {
  ONLINE
  OFFLINE
  DEGRADED
  MAINTENANCE
}

model GuardTask {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  siteId  String?
  site    Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  shiftId String?
  shift   GuardShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  title  String
  /// The time of night it is due, as the rota writes it — "02:00".
  dueAt  String          @default("")
  status GuardTaskStatus @default(DUE)
  note   String          @default("")
  doneAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, shiftId])
}

enum GuardTaskStatus {
  DUE
  DONE
  MISSED
  SKIPPED
}

model EmergencyPlan {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  kind      String
  where     String          @default("")
  procedure String          @default("")
  drillNote String          @default("")
  lastDrill DateTime?
  status    EmergencyStatus @default(READY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

enum EmergencyStatus {
  READY
  REVIEW_DUE
  GAP
}

/**
 * ====================================================================== *
 * AGENT & HOST — conversations, turnover, pricing.
 * ======================================================================
 */

model Conversation {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  /// Who the thread is with, kept alongside partyId so it survives the
  /// contact being removed — the same reason Reservation keeps guestName.
  withName String
  subject  String   @default("")
  /// Denormalised for the list, which is the only screen that needs it and
  /// would otherwise read every message of every thread to draw one column.
  lastText String   @default("")
  lastAt   DateTime @default(now())
  unread   Int      @default(0)
  closed   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([orgId])
  @@index([orgId, lastAt])
}

model Message {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// IN from the contact, OUT from this company. Not a userId: a message may
  /// have been sent by somebody who has since left.
  direction  MessageDirection @default(IN)
  authorName String           @default("")
  body       String
  /**
   * `createdAt` IS the message time, rather than a separate `at`.
   * Two columns meaning "when" is how they come to disagree, and a message is
   * not append-only — `readAt` is set later — so it cannot join the
   * APPEND_ONLY list in relations.test.js and skip timestamps. One column,
   * the schema's own convention.
   */
  readAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([conversationId, createdAt])
}

enum MessageDirection {
  IN
  OUT
}

model OpsTask {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  title    String
  assignee String        @default("")
  dueAt    DateTime?
  status   OpsTaskStatus @default(SCHEDULED)
  note     String        @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

enum OpsTaskStatus {
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED
}

model PricingRule {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  /// Kept alongside unitId for the same reason as Conversation.withName.
  label      String
  base       BigInt  @default(0)
  currency   String  @default("KES")
  /// Signed basis points, like RateRule.moveBps: +15% is 1500.
  weekendBps Int     @default(0)
  monthlyBps Int     @default(0)
  minNights  Int     @default(1)
  auto       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

/**
 * ====================================================================== *
 * THE PLATFORM'S OWN WORK.
 * These carry an orgId and it is the SUBJECT company, not the owner: a
 * moderation item is PALTAS's record ABOUT a customer. So they are NOT
 * registry resources — a company may not open a moderation case on itself —
 * and they are read through src/routes/platform.js, the one cross-tenant
 * reader in the service.
 * ======================================================================
 */

model ModerationItem {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  title      String
  reason     String             @default("")
  severity   ModerationSeverity @default(MEDIUM)
  status     ModerationStatus   @default(WAITING)
  decidedBy  String             @default("")
  decidedAt  DateTime?
  decidedWhy String             @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([status, createdAt])
}

enum ModerationSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ModerationStatus {
  WAITING
  UPHELD
  DISMISSED
  REMOVED
}

model ComplianceCase {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  ref       String
  kind      String
  /// The person the case concerns, by name. NOT a userId — a data request may
  /// come from somebody who never had an account.
  subject   String           @default("")
  detail    String           @default("")
  dueOn     DateTime?
  status    ComplianceStatus @default(OPEN)
  closedAt  DateTime?
  closedWhy String           @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ref])
  @@index([orgId])
  @@index([status, dueOn])
}

enum ComplianceStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  CLOSED
  ESCALATED
}

/**
 * ====================================================================== *
 * THE PRICE LIST.
 * The one model here with NO organization: a plan is PALTAS's catalogue, the
 * same for everybody, like a country code. Giving it an orgId would invite
 * exactly the bug that would then hide — a company quietly editing the price
 * it is charged.
 * ======================================================================
 */

model Plan {
  id   String @id @default(cuid())
  code String @unique

  name        String
  /// Minor units, per month, in `currency`.
  price       BigInt  @default(0)
  currency    String  @default("KES")
  /// "Up to 2 properties" — the limit as the price list states it, beside the
  /// number the service can actually enforce.
  limitText   String  @default("")
  propertyCap Int?
  includes    String  @default("")
  seq         Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ====================================================================== *
 * TOKENISED REAL-ESTATE INVESTMENT.
 * Additive. Nothing above this line changed except three things, each a
 * nullable column or a back-relation: Investor.userId, User.investors, and
 * Organization's relations to the models below.
 * ── WHAT PALTAS IS, AND IS NOT ──────────────────────────────────────────
 * PALTAS is the technology layer. It is not the property owner, not the
 * issuer, not the regulated partner and not the custodian. Those are other
 * legal entities, and the whole point of OfferingParty below is that each one
 * is named on the record rather than implied by the software holding it.
 * A token here is a unit of an offering. Whether it represents legal title,
 * a beneficial interest, a share in an SPV or a contractual right is a matter
 * for the offering documents and the jurisdiction — so this schema records
 * the structure and does not assert one.
 * ── WHAT IS REUSED RATHER THAN REBUILT ──────────────────────────────────
 * Project       the development an offering is raised against
 * Investor      the register — name, kind, committed, paid — already existed
 * Distribution  already existed, and now optionally names an Offering
 * Document      offering and legal documents, via OfferingDocument
 * Invoice       an order settles through the money path the platform has
 * Verification  the ISSUER company's own KYC, org-level, already existed
 * Nothing here duplicates any of them.
 * ======================================================================
 */

/// Whether this company may run offerings at all, and on whose authority.
///
/// NOT a subscription product. A company is eligible because a regulator
/// approved it, and PALTAS records that approval — it does not grant it. So
/// this carries the regulator's own reference, and `status` is the gate every
/// write in src/routes/investments.js checks before anything else.
model IssuerProfile {
  id    String       @id @default(cuid())
  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  status        IssuerStatus @default(NOT_APPLIED)
  /// The regulator, and the licence as the regulator writes it. Free text
  /// because "CMA", "DFSA" and "SEC" do not share a format and never will.
  regulator     String       @default("")
  licenceRef    String       @default("")
  /// ISO country codes this company is licensed to offer in, comma-separated.
  /// An offering may not name a jurisdiction absent from this list.
  jurisdictions String       @default("")
  legalName     String       @default("")
  approvedAt    DateTime?
  /// Who at PALTAS recorded the approval. A name, not a user id: the person
  /// may leave and the record must still say who decided.
  approvedBy    String       @default("")
  note          String       @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum IssuerStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  SUSPENDED
  WITHDRAWN
}

/// An investment opportunity raised against a property or development.
model Offering {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// What the money is for. A development, or a site, or a single unit —
  /// whichever the owner selected when they chose "Enable Investment".
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  ref       String
  title     String
  summary   String            @default("")
  structure OfferingStructure @default(SPV_EQUITY)

  /// Money in minor units, BigInt, like everywhere else in this schema.
  targetRaise BigInt @default(0)
  /// What has actually been received. Written only from settled orders —
  /// never set by hand, because a raise total that can be typed is a raise
  /// total that can be wrong in public.
  raised      BigInt @default(0)
  currency    String @default("KES")

  /// Units offered, and the price of one. `unitPrice * tokenUnits` should
  /// equal targetRaise; the service checks rather than assumes.
  tokenUnits Int    @default(0)
  unitPrice  BigInt @default(0)

  minInvestment BigInt @default(0)
  minUnits      Int    @default(1)

  eligibility   InvestorEligibility @default(PROFESSIONAL_ONLY)
  /// ISO country codes, comma-separated, and a subset of the issuer's own.
  jurisdictions String              @default("")

  /// How income is shared, in the operator's words, plus the one number the
  /// service can act on. A distribution ENGINE is not in scope; recording the
  /// rule a human applies is.
  distributionRule String @default("")
  targetYieldBps   Int    @default(0)

  status OfferingStatus @default(DRAFT)

  /// SANDBOX SEPARATION.
  ///
  /// True means this offering exists for technical testing and must never be
  /// counted, shown or settled as real. It is a column rather than a separate
  /// database because one connection string is one fewer thing to get wrong —
  /// and every read in src/routes/investments.js filters on it, so a sandbox
  /// row cannot appear in a production list by omission.
  sandbox Boolean @default(false)

  opensOn      DateTime?
  closesOn     DateTime?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  approvedAt   DateTime?
  liveAt       DateTime?
  closedAt     DateTime?
  /// Why a reviewer sent it back or refused it. A refusal with no reason is
  /// not a decision somebody can act on.
  decisionNote String    @default("")
  decidedBy    String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties       OfferingParty[]
  documents     OfferingDocument[]
  orders        InvestmentOrder[]
  holdings      TokenHolding[]
  events        TokenEvent[]
  distributions Distribution[]

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([orgId, status])
  @@index([status, sandbox])
}

/// The ten states, in order. An offering cannot be LIVE without APPROVED
/// behind it — src/domain/investments.js holds the transitions and
/// test/investments.test.js proves no path skips approval.
enum OfferingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  SCHEDULED
  LIVE
  FUNDED
  CLOSED
  DISTRIBUTING
  COMPLETED
  /// Not in the requested list, and necessary: a review that cannot refuse is
  /// not a review. Reaching it is terminal unless the offering is resubmitted.
  REJECTED
  CHANGES_REQUESTED
}

enum OfferingStructure {
  SPV_EQUITY
  DIRECT_CO_OWNERSHIP
  DEBT_NOTE
  REIT_UNIT
  PROFIT_SHARE
  OTHER
}

enum InvestorEligibility {
  PROFESSIONAL_ONLY
  ACCREDITED_ONLY
  RETAIL_PERMITTED
  BY_INVITATION
}

/// WHO IS WHO. The legal chain, named on the record.
///
/// One row per party rather than six columns on Offering, because the set is
/// jurisdiction-dependent and grows: a Kenyan SPV structure and a DIFC fund
/// do not have the same actors. A missing party is then a missing ROW that a
/// compliance check can name, rather than an empty string nobody notices.
model OfferingParty {
  id         String   @id @default(cuid())
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  role         PartyRole
  legalName    String
  /// Company number, licence number, LEI — whatever identifies this entity
  /// where it is registered.
  registration String    @default("")
  jurisdiction String    @default("")
  regulator    String    @default("")
  contact      String    @default("")
  note         String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offeringId, role, legalName])
  @@index([offeringId])
}

enum PartyRole {
  PROPERTY_OWNER
  LEGAL_OWNER
  ISSUER
  SPV
  REGULATED_PARTNER
  TOKENISATION_PROVIDER
  CUSTODIAN
  ADMINISTRATOR
  VALUER
  AUDITOR
}

/// An offering document, pointing at the existing Document table.
model OfferingDocument {
  id         String   @id @default(cuid())
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  role     OfferingDocRole @default(OTHER)
  required Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offeringId, documentId])
  @@index([offeringId])
}

enum OfferingDocRole {
  PROSPECTUS
  OFFERING_MEMORANDUM
  SUBSCRIPTION_AGREEMENT
  TITLE_DEED
  VALUATION
  TRUST_DEED
  SPV_CONSTITUTION
  REGULATORY_APPROVAL
  AUDITED_ACCOUNTS
  RISK_DISCLOSURE
  OTHER
}

/// Per-investor compliance, separate from the company's own Verification.
///
/// `Verification` is org-level and `orgId @unique` — it answers "is this
/// COMPANY verified", which is a different question from "may this PERSON be
/// sold this offering in this country". Extending Verification would have
/// meant making it non-unique and changing what every existing read means.
model InvestorProfile {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  investorId String   @unique
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  kyc         KycStatus @default(NOT_STARTED)
  aml         AmlStatus @default(NOT_SCREENED)
  /// The provider that actually performed the check, and its reference. PALTAS
  /// does not screen anybody; it records that somebody competent did.
  kycProvider String    @default("")
  kycRef      String    @default("")
  amlProvider String    @default("")
  amlRef      String    @default("")
  screenedAt  DateTime?
  expiresAt   DateTime?

  /// Where this investor is resident for eligibility, and what they qualify as.
  jurisdiction  String              @default("")
  classifiedAs  InvestorEligibility @default(PROFESSIONAL_ONLY)
  /// A named reason, when they are barred. Blank means nothing recorded.
  blockedReason String              @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, kyc])
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum AmlStatus {
  NOT_SCREENED
  CLEAR
  REVIEW
  BLOCKED
}

/// An investor's subscription to an offering.
model InvestmentOrder {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  ref      String
  units    Int    @default(0)
  amount   BigInt @default(0)
  currency String @default("KES")

  status OrderStatus @default(PENDING)

  /// SETTLEMENT GOES THROUGH THE MONEY PATH THAT ALREADY EXISTS.
  ///
  /// An order does not hold its own payment state. It points at an Invoice,
  /// and the Payment rows against that invoice are what make it settled — the
  /// same as every other sum of money in this platform. No provider is
  /// integrated, so nothing here may be marked settled without one.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// True only when this order belongs to a sandbox offering. Denormalised so
  /// a production query cannot include it by forgetting the join.
  sandbox Boolean @default(false)

  placedAt    DateTime  @default(now())
  allocatedAt DateTime?
  settledAt   DateTime?
  cancelledAt DateTime?
  refusedWhy  String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holdings TokenHolding[]

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([offeringId, status])
  @@index([investorId])
}

enum OrderStatus {
  PENDING
  COMPLIANCE_HOLD
  APPROVED
  AWAITING_PAYMENT
  SETTLED
  ALLOCATED
  CANCELLED
  REFUSED
  REFUNDED
}

/// Units an investor holds, as the tokenisation provider reports them.
///
/// NOT A LEDGER PALTAS COMPUTES. `units` is what the provider last told us,
/// `providerRef` is the provider's own identifier for the position, and
/// `asAt` is when they said it. If no provider is connected there are no rows
/// here — an empty holdings screen is the truth, and a number PALTAS arrived
/// at by adding up orders would be a claim about a blockchain it cannot see.
model TokenHolding {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  offeringId String
  offering   Offering         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  investorId String
  investor   Investor         @relation(fields: [investorId], references: [id], onDelete: Cascade)
  orderId    String?
  order      InvestmentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  units Int @default(0)

  /// The authoritative references, from the provider. Never generated here.
  provider     String @default("")
  providerRef  String @default("")
  custodian    String @default("")
  custodianRef String @default("")
  /// Chain and contract, when the provider works that way. Recorded as given.
  chain        String @default("")
  contractRef  String @default("")
  walletRef    String @default("")

  asAt    DateTime?
  sandbox Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offeringId, investorId, providerRef])
  @@index([orgId])
  @@index([investorId])
}

/// Append-only: what the tokenisation provider told us, when.
///
/// No updatedAt, because nothing updates it — the same reason AuditEvent and
/// FolioLine have none. If the provider later contradicts itself, that is a
/// NEW row, and the disagreement stays visible instead of being overwritten.
model TokenEvent {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  kind        TokenEventKind
  units       Int            @default(0)
  provider    String         @default("")
  /// The provider's own id for this event. Unique, so the same webhook
  /// delivered twice records once — an idempotency key, not decoration.
  externalRef String
  txRef       String         @default("")
  detail      Json?
  at          DateTime       @default(now())
  sandbox     Boolean        @default(false)

  createdAt DateTime @default(now())

  @@unique([provider, externalRef])
  @@index([orgId])
  @@index([offeringId, at])
}

enum TokenEventKind {
  MINT
  TRANSFER
  BURN
  LOCK
  UNLOCK
  DISTRIBUTION_PAID
  PROVIDER_MESSAGE
}

/**
 * ====================================================================== *
 * PALTAS PROPERTY DNA
 * "Every property has a memory."
 * NOT a seventh product. There is no PROPERTY_DNA in the Product enum and
 * nothing here is sold — it is the identity layer the six products already
 * share, made explicit.
 * ── WHY IT HANGS OFF Site AND NOT A NEW MODEL ───────────────────────────
 * Site already IS the property. Buildings, units, rooms, zones, assets,
 * visits, passes, vehicles, incidents, patrols, guard shifts, deliveries and
 * work orders — every one of them carries a siteId today. Property
 * management, security and hotel are already joined through it; what was
 * missing was a durable identifier, a memory, and a way to say that some of
 * what is known about a property is nobody else's business.
 * A second "Property" model would have split that in half and left two
 * answers to "which property is this?". So Property DNA is a 1:1 record ON
 * Site, and every model below points at Site through it.
 * ── THE ONE RULE THAT MATTERS ───────────────────────────────────────────
 * Every row that can carry private information carries a `class`, and is read
 * through src/domain/classification.js. Being able to see a property is not
 * the same as being able to see what a family paid for it.
 * ======================================================================
 */

/// How private a piece of information is. Ordered least to most restricted;
/// that order is the authority — see CLASS_RANK in domain/classification.js.
/**
 * ── WHY THE NEW VALUES ARE AT THE BOTTOM ────────────────────────────────
 * Postgres ALTER TYPE ... ADD VALUE APPENDS. Prisma compares the enum's
 * ORDER as well as its membership, so declaring a new value in the middle —
 * where it reads better — leaves the schema and the database disagreeing
 * forever, and schema.test.js says so.
 * Reading order is worth less than a schema that matches its database, so
 * the additions sit at the end in the order the migration adds them.
 */
enum DataClass {
  PUBLIC
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
  OWNER_ONLY
  LEGAL_RESTRICTED
  SECURITY_RESTRICTED
  AUTHORITY_RESTRICTED
}

/// What a person IS to a property, which is not the same as their job at the
/// company. A MANAGER has no ownership standing; a person with no company
/// role at all may be the owner.
enum PropertyRelation {
  OWNER
  CO_OWNER
  EXECUTOR
  ADMINISTRATOR
  TRUSTEE
  LEGAL_REPRESENTATIVE
  FAMILY_REPRESENTATIVE
  BENEFICIARY
  MANAGER
  DEVELOPER
  OPERATOR
}

/// Where a fact came from. Nothing here is "true"; it is sourced.
enum Provenance {
  OWNER_SUPPLIED
  MANAGER_SUPPLIED
  VERIFIED
  AI_SCAN
  IMPORTED_PMS
  PENDING
  DEVELOPER_SUPPLIED
  HOTEL_SUPPLIED
  AGENT_SUPPLIED
  IMPORTED_DOCUMENT
  GOVERNMENT
  LAND_REGISTRY
  PLANNING_AUTHORITY
}

enum VerificationState {
  UNVERIFIED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  USER_PROVIDED
  IMPORTED
  AUTHORITY_VERIFIED
  DISPUTED
  EXPIRED
}

enum SuccessionStatus {
  DRAFT
  INITIATED
  DOCUMENTS_REQUIRED
  UNDER_REVIEW
  VERIFICATION_PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
  DISPUTED
}

/// The kinds of thing a property remembers. Open-ended on purpose: a new kind
/// is a new value, never a new table.
enum TimelineKind {
  PROPERTY_CREATED
  DEVELOPER_ADDED
  CONSTRUCTION_STARTED
  CONSTRUCTION_COMPLETED
  INSPECTION_COMPLETED
  PROPERTY_VERIFIED
  UNIT_CREATED
  UNIT_LISTED
  LEASE_STARTED
  LEASE_ENDED
  MAINTENANCE_COMPLETED
  ASSET_INSTALLED
  ASSET_REPLACED
  RENOVATION_COMPLETED
  MANAGER_CHANGED
  OPERATOR_CHANGED
  OWNERSHIP_RECORDED
  SUCCESSION_INITIATED
  SUCCESSION_COMPLETED
  PROPERTY_SOLD
  REDEVELOPMENT_STARTED
  SCAN_RECORDED
  DOCUMENT_ADDED
  NOTE
  PLANNING_APPROVED
  PERMIT_ISSUED
  INSPECTION_PASSED
  OCCUPANCY_APPROVED
  ZONING_CHANGED
  OFFICIAL_NOTICE
  PARCEL_REGISTERED
  AUTHORITY_VERIFIED_RECORD
}

/**
 * The property's identity. One per Site, created on demand.
 * `ref` is the human-facing identifier — PALTAS-PROP-KE-NAI-00001234 — and it
 * is NOT the primary key. The cuid stays internal; the ref is what goes on a
 * QR code, a report or an email, and it is unique per organization so two
 * customers can never collide.
 */
model PropertyDna {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// One property, one DNA record.
  siteId String @unique
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// PALTAS-PROP-<country>-<city>-<sequence>
  ref String

  verification VerificationState @default(UNVERIFIED)
  verifiedAt   DateTime?
  verifiedBy   String            @default("")
  verifiedNote String            @default("")

  /// What a public profile may say. Nothing leaves this record for the
  /// marketplace unless it is switched on deliberately.
  publicProfile Boolean @default(false)
  publicSummary String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeline   PropertyTimelineEvent[]
  ownership  PropertyOwnershipRecord[]
  relations  PropertyRelationship[]
  heritage   PropertyHeritageRecord[]
  succession SuccessionCase[]
  scans      PropertyScan[]

  authorityRecords  PropertyAuthorityRecord[]
  authorityRequests AuthorityRequest[]

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([orgId, verification])
}

/**
 * The memory. Append-only by contract: there is no update route and no delete
 * route for these, and the test suite asserts it. A correction is a NEW event
 * saying what changed — the same rule the work-order history already follows,
 * for the same reason.
 */
model PropertyTimelineEvent {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dnaId String
  dna   PropertyDna @relation(fields: [dnaId], references: [id], onDelete: Cascade)

  kind   TimelineKind
  at     DateTime     @default(now())
  title  String
  detail String       @default("")

  /// What this event is about, when it is about something: a unit, a lease, a
  /// work order. A loose pair rather than nine nullable foreign keys.
  entity   String @default("")
  entityId String @default("")

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String  @default("")

  source       Provenance        @default(MANAGER_SUPPLIED)
  verification VerificationState @default(UNVERIFIED)
  class        DataClass         @default(INTERNAL)

  createdAt DateTime @default(now())

  @@index([orgId, dnaId, at])
  @@index([orgId, kind])
}

/**
 * Who a person is TO a property. Separate from Membership, which says what
 * their job is at the company.
 * `clearance` is the ceiling this relationship grants on THIS property. An
 * executor gets LEGAL_RESTRICTED and nothing beyond it; a manager gets
 * RESTRICTED however senior they are at the company.
 */
model PropertyRelationship {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dnaId String
  dna   PropertyDna @relation(fields: [dnaId], references: [id], onDelete: Cascade)

  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// A party who is not a PALTAS user yet — a named heir, a family member.
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  name     String           @default("")
  relation PropertyRelation

  /// The highest classification this relationship may read on this property.
  clearance DataClass @default(RESTRICTED)

  startedOn DateTime  @default(now())
  endedOn   DateTime?
  active    Boolean   @default(true)

  note String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, dnaId, active])
  @@index([orgId, userId])
}

/**
 * An ownership RECORD, not a determination of ownership.
 * PALTAS records what it was shown and who showed it. It does not decide who
 * owns anything — see the note on SuccessionCase.
 */
model PropertyOwnershipRecord {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dnaId String
  dna   PropertyDna @relation(fields: [dnaId], references: [id], onDelete: Cascade)

  holder     String
  holderKind String @default("INDIVIDUAL")
  /// Basis points, so a third is 3333 rather than 33.33. Nullable because a
  /// share is often simply not recorded.
  shareBp    Int?

  fromOn DateTime?
  toOn   DateTime?
  active Boolean   @default(true)

  basis        String            @default("")
  source       Provenance        @default(OWNER_SUPPLIED)
  verification VerificationState @default(UNVERIFIED)
  class        DataClass         @default(OWNER_ONLY)

  supersededById String?
  note           String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, dnaId, active])
}

/**
 * The family's own account of the property. Optional, owner-controlled, and
 * OWNER_ONLY until an owner decides otherwise — `publicOk` is the only thing
 * that lets a line of it reach a public profile.
 */
model PropertyHeritageRecord {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dnaId String
  dna   PropertyDna @relation(fields: [dnaId], references: [id], onDelete: Cascade)

  year   Int?
  on     DateTime?
  title  String
  story  String    @default("")
  family String    @default("")

  class    DataClass  @default(OWNER_ONLY)
  publicOk Boolean    @default(false)
  source   Provenance @default(OWNER_SUPPLIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, dnaId])
}

/**
 * SUCCESSION.
 * ── WHAT THIS IS NOT ────────────────────────────────────────────────────
 * It is not a determination of inheritance and it must never become one.
 * PALTAS is a place to assemble and track documentation; who inherits what is
 * decided by people and by law, in a jurisdiction, with an authority PALTAS
 * does not have and must not claim.
 * Concretely: reaching COMPLETED does not move a property to anybody. It
 * records that a documented process concluded. Changing who holds the
 * property is a separate, deliberate, audited act — and the previous holder
 * stays in the record either way.
 */
model SuccessionCase {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dnaId String
  dna   PropertyDna @relation(fields: [dnaId], references: [id], onDelete: Cascade)

  ref          String
  status       SuccessionStatus @default(DRAFT)
  /// Free text on purpose: succession is not the same process in two
  /// countries, and PALTAS models no one of them.
  jurisdiction String           @default("")

  openedById String?
  openedBy   User?   @relation("SuccessionOpener", fields: [openedById], references: [id], onDelete: SetNull)
  openedName String  @default("")

  representative String @default("")
  reason         String @default("")
  note           String @default("")

  class DataClass @default(LEGAL_RESTRICTED)

  openedAt  DateTime  @default(now())
  decidedAt DateTime?
  closedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiaries SuccessionBeneficiary[]
  steps         SuccessionStep[]

  @@unique([orgId, ref])
  @@index([orgId, dnaId, status])
}

model SuccessionBeneficiary {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  caseId String
  case   SuccessionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  name     String
  relation PropertyRelation @default(BENEFICIARY)
  /// Basis points. RECORDED, not adjudicated — a share here is what the
  /// documentation says, not what PALTAS has decided anybody is owed.
  shareBp  Int?
  contact  String           @default("")

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  verification VerificationState @default(UNVERIFIED)
  note         String            @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, caseId])
}

/// Every move a case makes, and who made it. A case's status is the latest
/// step rather than only an overwritten column, so a disputed case can be
/// read backwards.
model SuccessionStep {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  caseId String
  case   SuccessionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  from SuccessionStatus?
  to   SuccessionStatus
  why  String            @default("")

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String  @default("")

  at DateTime @default(now())

  @@index([orgId, caseId, at])
}

/**
 * A scan is EVIDENCE, and what is read out of it is a SUGGESTION.
 * Nothing a scan produces is treated as fact. Each finding carries its
 * source, a confidence and `verified=false` until a person says otherwise —
 * and the routes refuse to let an unconfirmed finding into the property's
 * structure.
 */
model PropertyScan {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dnaId String
  dna   PropertyDna @relation(fields: [dnaId], references: [id], onDelete: Cascade)

  kind       String @default("PHOTO")
  storageKey String @default("")
  note       String @default("")

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedName String  @default("")

  /// PENDING until an extraction provider has actually run. There is no
  /// provider configured today, and the route says so rather than inventing
  /// findings.
  state String    @default("PENDING")
  class DataClass @default(RESTRICTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings PropertyScanFinding[]

  @@index([orgId, dnaId])
}

model PropertyScanFinding {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  scanId String
  scan   PropertyScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  kind   String
  label  String
  detail String @default("")

  /// 0..100. Null when the provider gave none.
  confidence Int?
  source     Provenance @default(AI_SCAN)

  verified   Boolean   @default(false)
  verifiedBy String    @default("")
  verifiedAt DateTime?
  rejected   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, scanId, verified])
}

/**
 * ====================================================================== *
 * THE AUTHORITY LAYER
 * A property has three kinds of information about it, and they do not merge:
 * OWNER      what the family knows — heritage, succession, what was paid
 * BUSINESS   what the operator knows — tenants, rooms, guards, work orders
 * AUTHORITY  what the state knows — the parcel, the zoning, the permits
 * ── THE RULE THIS WHOLE SECTION EXISTS TO ENFORCE ───────────────────────
 * "Government = see everything" is not built here and must never be. An
 * authority reaches a property through a MANDATE: an authority, over a
 * jurisdiction, for a dataset, for a purpose. A planning authority that may
 * read a zoning decision has no route to a will, a private valuation or a
 * camera map — not because the UI hides them, but because the mandate does
 * not name them and the classification refuses them.
 * AUTHORITY_RESTRICTED is a CLASS, not a rung. An owner does not inherit it
 * by being senior, and an authority does not climb from it to OWNER_ONLY.
 * The two are different rooms, not different floors.
 * ── WHAT IS DELIBERATELY GENERIC ────────────────────────────────────────
 * No country's administrative structure is modelled. A jurisdiction is a
 * self-referencing tree with a level NAME rather than fixed columns for
 * county and municipality, because "county" means different things in three
 * countries and nothing at all in a fourth.
 * ======================================================================
 */

/// What kind of body an organization is. Every existing organization is a
/// CUSTOMER and stays one — the column defaults to it, so no migration has
/// to guess.
enum OrgKind {
  CUSTOMER
  GOVERNMENT
  MUNICIPALITY
  CITY_AUTHORITY
  COUNTY
  LAND_AUTHORITY
  PLANNING_AUTHORITY
  PROPERTY_REGISTRY
  TAX_AUTHORITY
  BUILDING_AUTHORITY
  OTHER_PUBLIC_AUTHORITY
}

/// The datasets a mandate can name. A mandate grants some of these and never
/// "all" — there is no wildcard value, deliberately.
enum AuthorityDataset {
  PROPERTY_IDENTITY
  LOCATION
  PARCEL
  ZONING
  PLANNING
  PERMITS
  INSPECTIONS
  COMPLIANCE
  OFFICIAL_DOCUMENTS
  REGISTRATION
  TRANSFER_RECORDS
  TAX_RELEVANT
  BUILDING_FOOTPRINT
}

/// Why information may lawfully be reached. Consent is ONE basis and not the
/// only one — a registry does not ask an owner's permission to hold a title,
/// and modelling everything as consent would make the record dishonest.
enum DataAccessBasis {
  OWNER_CONSENT
  LEGAL_AUTHORITY
  REGULATORY_REQUIREMENT
  PUBLIC_RECORD
  CONTRACTUAL
  AUTHORIZED_OPERATIONAL_ACCESS
  OTHER_CONFIGURED_BASIS
}

enum AuthorityRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REFUSED
  WITHDRAWN
  EXPIRED
}

/// What an authority record is about. Open-ended; a new kind is a value.
enum AuthorityRecordKind {
  PARCEL_REGISTRATION
  ZONING_DECISION
  PLANNING_APPROVAL
  BUILDING_PERMIT
  OCCUPANCY_APPROVAL
  INSPECTION
  COMPLIANCE_NOTICE
  OFFICIAL_NOTICE
  RESTRICTION
  TRANSFER_RECORD
  VALUATION_ROLL
  OTHER
}

/**
 * A JURISDICTION, as a tree.
 * Country → region → county → municipality → district → zone, or three of
 * those, or six, depending on the country. `level` is a NAME rather than an
 * enum so a country that has no counties does not have to pretend.
 * `path` is the materialised ancestry ("KE/NAIROBI/WESTLANDS") and it is what
 * containment is decided by: a mandate over KE/NAIROBI covers a property in
 * KE/NAIROBI/WESTLANDS because the second starts with the first. A recursive
 * query per property read would be the alternative, and this is the one that
 * stays fast when an authority lists a thousand parcels.
 */
model Jurisdiction {
  id String @id @default(cuid())

  /// Which authority organization maintains this node. Jurisdictions are not
  /// global reference data: two authorities may describe the same ground
  /// differently, and PALTAS is not the arbiter of who is right.
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Jurisdiction?  @relation("JurisdictionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Jurisdiction[] @relation("JurisdictionTree")

  code    String
  name    String
  /// "country", "county", "municipality", "planning zone" — a word, not an enum.
  level   String @default("")
  country String @default("")

  /// Materialised ancestry, uppercase, slash-separated. Containment is a
  /// prefix test against this.
  path String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mandates AuthorityMandate[]
  parcels  Parcel[]
  records  PropertyAuthorityRecord[]

  @@unique([orgId, path])
  @@index([orgId, parentId])
  @@index([path])
}

/**
 * The profile that makes an organization a public authority.
 * Separate from Organization so that the authority columns do not sit on
 * every customer's row, and so that becoming an authority is a deliberate
 * act with its own verification rather than a flag somebody can set.
 * `verified` is PALTAS's own check that this body is what it says it is.
 * An unverified authority profile grants nothing: every mandate is refused
 * until it is true.
 */
model AuthorityProfile {
  id    String       @id @default(cuid())
  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  kind        OrgKind
  legalName   String  @default("")
  country     String  @default("")
  /// How this body is identified officially, where it has such an identifier.
  officialRef String  @default("")

  verified   Boolean   @default(false)
  verifiedAt DateTime?
  verifiedBy String    @default("")
  note       String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mandates AuthorityMandate[]
  requests AuthorityRequest[]

  @@index([kind])
}

/**
 * A MANDATE: this authority, over this jurisdiction, for these datasets, on
 * this basis, for this long.
 * This is the whole access model for an authority, and it is deliberately
 * narrow. There is no "all datasets" value and no "all jurisdictions" value,
 * so the widest possible mandate is still an enumerated list somebody wrote
 * down and somebody else can read back.
 */
model AuthorityMandate {
  id String @id @default(cuid())

  profileId String
  profile   AuthorityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  /// Enumerated. No wildcard.
  datasets AuthorityDataset[]
  basis    DataAccessBasis    @default(LEGAL_AUTHORITY)

  /// What this mandate is FOR, in words, on the record. A mandate with no
  /// stated purpose is one nobody can review.
  purpose String @default("")

  /// A mandate may read. Writing an official record is a separate grant,
  /// because an authority correcting its own register and an authority
  /// browsing are not the same act.
  mayWrite Boolean @default(false)

  startsOn DateTime  @default(now())
  endsOn   DateTime?
  active   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, active])
  @@index([jurisdictionId])
}

/**
 * A LAND PARCEL.
 * Land exists before buildings and outlives them, so a parcel is not a
 * property and must not be modelled as one. One parcel can carry several
 * properties; one development can span several parcels; parcels are
 * subdivided and consolidated. That is why the link to Site is a join table
 * rather than a column on either side.
 */
model Parcel {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// The official parcel number, as the authority writes it.
  ref   String
  label String @default("")

  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)

  /// Enough geography to place it, and no more. Boundaries and polygons are
  /// deliberately absent: a half-built GIS is worse than none, and the
  /// columns it would need can be added without changing anything here.
  lat     Float?
  lng     Float?
  areaSqm Int?
  tenure  String @default("")
  zoning  String @default("")

  source       Provenance        @default(GOVERNMENT)
  verification VerificationState @default(UNVERIFIED)
  class        DataClass         @default(AUTHORITY_RESTRICTED)

  /// Subdivision and consolidation, recorded rather than resolved: the
  /// parcels a parcel came from, and whether it is still current.
  fromParcelIds String  @default("")
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties PropertyParcel[]
  records    PropertyAuthorityRecord[]

  @@unique([orgId, ref])
  @@index([orgId, jurisdictionId])
  @@index([orgId, active])
}

/// The many-to-many between land and what is built on it, because neither
/// direction is single.
model PropertyParcel {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  parcelId String
  parcel   Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  note String @default("")

  createdAt DateTime @default(now())

  @@unique([parcelId, siteId])
  @@index([orgId, siteId])
}

/**
 * AN OFFICIAL RECORD about a property: a permit, a zoning decision, an
 * inspection, a notice.
 * It carries the authority that issued it, the jurisdiction it was issued
 * under, its own reference, and its provenance — so a reader can always tell
 * "the planning authority approved this" from "the owner says the planning
 * authority approved this".
 */
model PropertyAuthorityRecord {
  id    String       @id @default(cuid())
  /// The organization whose property this is — the customer, not the
  /// authority. Tenant isolation follows the property, always.
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dnaId String
  dna   PropertyDna @relation(fields: [dnaId], references: [id], onDelete: Cascade)

  parcelId String?
  parcel   Parcel? @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)

  kind    AuthorityRecordKind
  dataset AuthorityDataset
  ref     String              @default("")
  title   String
  detail  String              @default("")

  /// Who issued it, by name, because the issuing body may not be a PALTAS
  /// organization at all.
  issuedByOrgId String?
  issuedByName  String  @default("")

  issuedOn  DateTime?
  expiresOn DateTime?
  status    String    @default("")

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  source       Provenance        @default(GOVERNMENT)
  verification VerificationState @default(UNVERIFIED)
  class        DataClass         @default(AUTHORITY_RESTRICTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, dnaId, kind])
  @@index([orgId, dataset])
  @@index([jurisdictionId])
}

/**
 * AN AUTHORITY ASKING FOR SOMETHING IT DOES NOT ALREADY HOLD.
 * Asking is not receiving. A request names the property, the datasets and the
 * basis; somebody authorised decides; the decision and its scope are
 * recorded; and the access that follows is the access that was granted, not
 * the access that was asked for.
 * Nothing in this model gives an authority data when it is created.
 */
model AuthorityRequest {
  id String @id @default(cuid())

  /// The authority asking.
  profileId String
  profile   AuthorityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// The company whose property it is. Both sides are named because the
  /// request is a record of a relationship between two organizations.
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dnaId String?
  dna   PropertyDna? @relation(fields: [dnaId], references: [id], onDelete: SetNull)

  datasets  AuthorityDataset[]
  basis     DataAccessBasis
  purpose   String
  /// The legal instrument relied on, where there is one.
  reference String             @default("")

  status AuthorityRequestStatus @default(DRAFT)

  /// What was actually granted, which may be less than what was asked for.
  grantedDatasets AuthorityDataset[]
  decidedById     String?
  decidedByName   String             @default("")
  decidedAt       DateTime?
  decisionNote    String             @default("")

  /// Access does not last forever by default.
  expiresOn DateTime?

  /// Whether the property's owner was told. Configurable because whether
  /// notice is required is a question of law in a jurisdiction, and PALTAS
  /// does not answer those.
  ownerNotified   Boolean   @default(false)
  ownerNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([profileId, status])
}

/// ══════════════════════════════════════════════════════════════════════
/// THE LEDGER
///
/// Everything financial this platform reports has to be derivable from
/// here. Totals kept on other tables are a convenience at best and a
/// second opinion at worst: when a figure on a dashboard and a figure in
/// a statement disagree, the only way to settle it is a place where every
/// movement was written once, in balance, and never quietly changed.
///
/// Three rules are enforced in code, not convention, and they are the
/// reason this exists:
///   1. a posted entry balances — total debits equal total credits
///   2. a posted entry is immutable — corrections are new reversing entries
///   3. nothing crosses an organization boundary
///
/// Amounts are BigInt MINOR UNITS, matching Payment and Expense already in
/// this schema. Cents, not fractions of a cent: floating point has no place
/// in a column somebody reconciles against a bank.
/// ══════════════════════════════════════════════════════════════════════

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

/// Which side increases the balance. Stored rather than derived so a report
/// never has to re-guess the sign convention.
enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  /// Being built. Does not appear in any report and need not balance yet.
  DRAFT
  /// Final. Balanced, in an open period, and from here on immutable.
  POSTED
  /// Cancelled by a reversing entry. The original rows stay exactly as posted.
  REVERSED
}

enum PeriodStatus {
  OPEN
  CLOSING
  CLOSED
}

/// One line of the chart of accounts, per organization.
model LedgerAccount {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Stable within the organization: "1000", "4010". What an accountant asks for.
  code   String
  name   String
  type   AccountType
  /// Which side increases it. ASSET/EXPENSE debit; LIABILITY/INCOME/EQUITY credit.
  normal NormalBalance

  /// Sub-accounts, so "Utilities" can hold "Water" and "Electricity" without
  /// a second table.
  parentId String?
  parent   LedgerAccount?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children LedgerAccount[] @relation("AccountTree")

  /// Only leaves take postings; a parent is a heading.
  postable Boolean @default(true)
  /// Withdrawn accounts stop accepting new lines and keep their history.
  active   Boolean @default(true)

  /// Where this account's money physically sits, when it is a bank account.
  /// Nullable because most accounts are not bank accounts.
  bankRef String?

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, code])
  @@index([orgId, type])
  @@index([orgId, active])
}

/// A month (or any range) that can be closed against further posting.
model FinancialPeriod {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// "2026-09". Unique per organization.
  label    String
  opensAt  DateTime
  closesAt DateTime
  status   PeriodStatus @default(OPEN)

  /// Who closed it and when — and, if it was reopened, who did that.
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?

  entries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, label])
  @@index([orgId, status])
  @@index([orgId, opensAt, closesAt])
}

/// One balanced financial event.
model JournalEntry {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Human reference, unique per organization: "JE-2026-000123".
  ref  String
  /// The date the event belongs to in the books, which is not always the day
  /// somebody typed it in.
  date DateTime

  periodId String?
  period   FinancialPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  status JournalStatus @default(DRAFT)
  memo   String        @default("")

  /// What caused this. `sourceType` names a table ("Invoice", "Payment",
  /// "Expense", "Payout"); `sourceId` is the row. Not a foreign key for the
  /// same reason AuditEvent's is not: one column cannot reference nine tables.
  sourceType String?
  sourceId   String?

  /// The currency the event happened in, and what it was worth in the
  /// organization's reporting currency. The original is never overwritten.
  currency     String
  baseCurrency String
  /// Rate as a string to avoid binary-float drift; "1" when they match.
  fxRate       String    @default("1")
  fxSource     String?
  fxAt         DateTime?

  /// Set once posted. Nothing may change after this is written.
  postedAt   DateTime?
  postedById String?

  /// A reversal points at what it cancels; the original points back.
  reversesId     String?       @unique
  reverses       JournalEntry? @relation("Reversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy     JournalEntry? @relation("Reversal")
  reversalReason String?

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, ref])
  @@index([orgId, status, date])
  @@index([orgId, sourceType, sourceId])
  @@index([periodId])
}

/// One side of one entry. Exactly one of debit/credit is non-zero.
model JournalLine {
  id    String       @id @default(cuid())
  /// The organization owns the line as well as the entry. A real foreign key,
  /// not a loose column: isolation that lives only in application code is a
  /// convention, and a hand-written query is all it takes to ignore one.
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  /// Minor units, never negative. Direction is which column is filled, so a
  /// report never has to interpret a sign.
  debit  BigInt @default(0)
  credit BigInt @default(0)

  /// The same amount in the organization's reporting currency.
  baseDebit  BigInt @default(0)
  baseCredit BigInt @default(0)

  memo String @default("")

  /// What this line is ABOUT, for per-property and per-tenant reporting.
  /// Nullable throughout: a bank fee belongs to no unit.
  siteId     String?
  buildingId String?
  unitId     String?
  leaseId    String?
  partyId    String?

  createdAt DateTime @default(now())

  @@index([orgId, accountId])
  @@index([entryId])
  @@index([orgId, siteId])
  @@index([orgId, unitId])
  @@index([orgId, partyId])
}
