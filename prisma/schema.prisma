// ======================================================================
// THE PALTAS DATA MODEL.
//
// Every enum below is copied from `assets/session.js` in the frontend, value
// for value. That is deliberate and it is the whole point: the session object
// this API returns is handed to the frontend untranslated, so a value the
// database can hold that the frontend cannot read is a bug the schema should
// have prevented.
//
// The chain the frontend reads, in order:
//
//   USER  →  ORGANIZATION  →  SUBSCRIPTION  →  ENTITLEMENT[]
//                          →  MEMBERSHIP(role, scope)  →  WORKSPACE
//
//   Entitlement decides which CONSOLE exists.   Role decides what is INSIDE it.
//   They are different questions and this schema keeps them in different tables.
// ======================================================================

generator client {
  provider = "prisma-client-js"
  // No preview features, and `driverAdapters` in particular is deliberately
  // absent — see the long note in src/db.js. It was tried twice and taken
  // back out both times, for the same reason: it cannot be exercised where
  // this was written, and the path every request takes is the wrong place
  // for code nobody has run.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

/// The five products. PLATFORM is PALTAS's own staff console.
enum Product {
  PROPERTY_MANAGEMENT
  AGENT_HOST
  HOTEL_MANAGEMENT
  SECURITY_MANAGEMENT
  GUEST_PORTAL
  PLATFORM
}

/// TRIALING, ACTIVE and PAST_DUE all open the console. The wall is CANCELED
/// and EXPIRED — and even then nothing is deleted.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Verification NEVER closes a console. It restricts `publish` and `payout`
/// and nothing else — see lib/rights.js, which is the only place that decides.
enum VerificationStatus {
  NOT_STARTED
  PENDING
  ADDITIONAL_INFORMATION_REQUIRED
  REJECTED
  COMPLETE
}

/// A role is a job. Every value here exists in the frontend's ROLES table.
enum Role {
  OWNER
  MANAGER
  OPERATIONS
  HOST
  LEASING
  PROMO_CONTRIBUTOR
  FINANCE
  RECEPTIONIST
  SECURITY_MANAGER
  GM
  FRONT_DESK
  HOUSEKEEPING
  ENGINEERING
  FNB
  GUEST
  GUARD
  // PALTAS staff. Three roles, and the split between them is the product's
  // only real guarantee about what reaches the public homepage.
  MARKETING
  COMPLIANCE
  PUBLISHER
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// The promotion workflow. Twelve states, and exactly one of them is public —
/// see the `PUBLIC_STATES` constant in src/lib/promotions.js, which is the one
/// place that decides and the only thing GET /promotions/public consults.
enum PromotionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  MARKETING_APPROVED
  FINAL_APPROVED
  SCHEDULED
  PUBLISHED
  PAUSED
  EXPIRED
  REJECTED
}

// ---------------------------------------------------------------- people

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  phone     String   @default("")
  /// Google's stable subject claim. NOT the email: people change emails, and
  /// Google's `sub` is the only identifier Google promises never to reuse.
  googleSub String?  @unique
  picture   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  sessions        Session[]
  promotions      Promotion[]      @relation("PromotionAuthor")
  events          PromotionEvent[]
  /// What this person did. SetNull on delete: the record outlives the account.
  auditEvents     AuditEvent[]
  workOrderEvents WorkOrderEvent[]
  incidentEvents  IncidentEvent[]

  @@index([googleSub])
}

/// A signed-in browser. Rows here are the reason a sign-out is real: deleting
/// the row ends the session everywhere, which a self-contained JWT cannot do.
model Session {
  id        String        @id @default(cuid())
  /// The cookie holds a random token; this column holds its SHA-256. A leaked
  /// database backup is then not a pile of working session cookies.
  tokenHash String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which organization this browser is currently acting for. A person can
  /// belong to several; the session remembers which one they chose.
  ///
  /// A REFERENCE, not ownership — a session belongs to a USER. It is a real
  /// foreign key so that deleting a company cannot leave live sessions
  /// pointing at an organization that no longer exists; SetNull drops the
  /// pointer and the next read falls back to the person's first membership.
  ///
  /// Nothing trusts this value on its own. sessionView() re-derives the
  /// organization from the person's memberships every time, so a stale or
  /// revoked orgId grants nothing — this constraint removes a dangling
  /// reference, it is not what makes the session safe.
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  userAgent String        @default("")
  ip        String        @default("")
  expiresAt DateTime
  createdAt DateTime      @default(now())
  /// Sessions ARE updated — switching organization writes to this row — so
  /// when that last happened is worth knowing when a sign-in is disputed.
  updatedAt DateTime      @default(now()) @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// --------------------------------------------------------- the company

model Organization {
  id        String    @id @default(cuid())
  name      String
  country   String    @default("ke")
  city      String    @default("")
  size      String    @default("")
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subscription Subscription?
  verification Verification?
  workspace    Workspace?
  entitlements Entitlement[]
  memberships  Membership[]
  promotions   Promotion[]
  /// Sessions currently acting for this company. SetNull on delete — see the
  /// comment on Session.orgId.
  sessions     Session[]

  /// ---- the shared spine ----
  sites       Site[]
  buildings   Building[]
  units       Unit[]
  parties     Party[]
  documents   Document[]
  auditEvents AuditEvent[]

  /// ---- property & development ----
  leases     Lease[]
  projects   Project[]
  workOrders WorkOrder[]
  assets     Asset[]

  /// ---- hotel ----
  rooms         Room[]
  reservations  Reservation[]
  folios        Folio[]
  hotelServices HotelService[]

  /// ---- agent & host ----
  listings Listing[]
  leads    Lead[]
  viewings Viewing[]
  deals    Deal[]

  /// ---- security ----
  zones       Zone[]
  visits      Visit[]
  passes      Pass[]
  vehicles    Vehicle[]
  incidents   Incident[]
  guardShifts GuardShift[]
  patrols     Patrol[]
  deliveries  Delivery[]

  /// ---- money ----
  invoices Invoice[]
  payments Payment[]
  expenses Expense[]
  payouts  Payout[]
}

model Subscription {
  id        String             @id @default(cuid())
  orgId     String             @unique
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(TRIALING)
  plan      String             @default("")
  planKey   String             @default("")
  trialDays Int                @default(30)
  seats     Int                @default(1)
  trialEnds DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Entitlement {
  id      String            @id @default(cuid())
  orgId   String
  org     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product Product
  status  EntitlementStatus @default(ACTIVE)
  since   DateTime          @default(now())

  /// One entitlement per product per company. An account holding both "host"
  /// and "agent" holds ONE product, and counting it twice sent that customer
  /// to a workspace door offering the same console twice.
  @@unique([orgId, product])
}

model Membership {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role   Role         @default(OWNER)
  /// What this person may see inside the company, as JSON: `{"all": true}` or
  /// `{"sites": ["ST-1", "ST-3"]}`. A guard on two gates is not a guard on
  /// every gate, and the frontend already reads this shape.
  scope  Json         @default("{\"all\": true}")

  createdAt DateTime @default(now())
  /// Role changes are edits to this row, so when it last changed is the
  /// answer to "when was this person promoted".
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
}

model Verification {
  id        String             @id @default(cuid())
  orgId     String             @unique
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status    VerificationStatus @default(NOT_STARTED)
  /// `[{ kind, name, uploadedAt, status }]`. File bytes are not in this
  /// database — this is the register of what was supplied, not the store.
  documents Json               @default("[]")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Workspace {
  id        String       @id @default(cuid())
  orgId     String       @unique
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status    String       @default("ACTIVE")
  /// Which console this company lands in when several are entitled.
  preferred String       @default("")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// --------------------------------------------------------- promotions

model Promotion {
  id    String       @id @default(cuid())
  /// The human-facing reference, PR-0001. Sequential per deployment, and what
  /// a customer quotes when they ring up.
  ref   String       @unique
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title       String @default("")
  headline    String @default("")
  subtitle    String @default("")
  description String @default("")
  type        String @default("")
  offer       String @default("")

  startDate DateTime?
  endDate   DateTime?

  destination    String @default("")
  ctaLabel       String @default("")
  ctaDestination String @default("")
  terms          String @default("")

  image     String @default("")
  /// `{ name, w, h, mb, busy }` — the properties the creative check reads.
  imageMeta Json?

  placement String @default("discover")
  audience  String @default("all")
  language  String @default("en")
  priority  Int    @default(50)

  /// ---- market targeting -------------------------------------------------
  /// All optional, all NARROWING. A promotion carrying none of them is
  /// global, which is the right default because most campaigns are.
  ///
  /// Null, never an empty array: "I did not target this" and "I targeted
  /// nothing" are different statements, and the second one read as a filter
  /// hides the promotion everywhere.
  countries        String[]
  excludeCountries String[]
  regions          String[]
  cities           String[]
  currencies       String[]
  languages        String[]
  /// The strongest two, and the ones worth reaching for. Naming Kenya is a
  /// guess that M-Pesa is on there; asking whether M-Pesa resolves is the
  /// fact, and it stays true the day a provider is switched off.
  requiresPayment  String?
  requiresService  String?
  requiresProduct  String?

  status    PromotionStatus @default(DRAFT)
  /// True when the assistant drafted any of the copy. Kept because a reviewer
  /// is entitled to know, and because the customer was told it would be.
  aiDrafted Boolean         @default(false)

  createdById String
  createdBy   User   @relation("PromotionAuthor", fields: [createdById], references: [id])
  reviewedBy  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PromotionEvent[]

  /// The index GET /promotions/public actually uses. It is the only query in
  /// the product an anonymous visitor can cause, so it is the one that has to
  /// stay fast when there are a hundred thousand rows.
  @@index([status, startDate, endDate])
  @@index([orgId, status])
}

/// Every decision, with who and why. Append-only: nothing here is ever edited
/// or removed, because "what exactly did PALTAS ask me for, and when" is a
/// question a customer is entitled to a straight answer to.
model PromotionEvent {
  id          String          @id @default(cuid())
  promotionId String
  promotion   Promotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  /// "created", "submitted", "changes requested", "published", …
  what        String
  /// The message shown to the customer. On a changes-requested event this is
  /// the ONLY thing they see, which is why the API refuses an empty one.
  why         String          @default("")
  /// The state the promotion was left in by this event.
  status      PromotionStatus
  byId        String?
  by          User?           @relation(fields: [byId], references: [id], onDelete: SetNull)
  /// Kept as text as well as a relation: a reviewer who later leaves the
  /// company must not erase the fact that they made the decision.
  byName      String          @default("")
  at          DateTime        @default(now())

  @@index([promotionId, at])
}

/// One row, holding the promotion counter. A sequence in its own table rather
/// than counting existing rows: two people creating a promotion in the same
/// second must not both be told they made PR-0007.
model Counter {
  name  String @id
  value Int    @default(0)
}

// ======================================================================
// ======================================================================
//
//                     THE PRODUCTS
//
// Everything above this line is the platform spine: who signed in, which
// company they act for, what that company bought. Everything below is the
// work those companies actually do.
//
// FOUR RULES HOLD FOR EVERY MODEL BELOW, WITHOUT EXCEPTION:
//
//   1. `orgId` + `onDelete: Cascade` + an index on it. One database holds
//      many companies' businesses; a model that cannot be scoped to one is
//      a model that leaks. test/tenancy.test.js fails the build otherwise.
//
//   2. Money is an INTEGER of minor units (cents, not dollars) plus a
//      currency code. Never Float. 0.1 + 0.2 is not 0.3 in binary floating
//      point, and a rent roll that is wrong by a cent per row is wrong by
//      real money at the bottom of the page.
//
//   3. Anything a person can be held to — a decision, a state change, a
//      sum — is append-only history, not an overwritten field.
//
//   4. No file bytes. Documents carry a provider reference and a checksum;
//      the bytes live in object storage. A passport scan in a Postgres row
//      ends up in every backup, every replica and every dump.
//
// ======================================================================

/// Money, everywhere. Minor units — 125050 is KES 1,250.50.
/// Kept as a repeated pair rather than a shared type because Prisma has no
/// composite scalar, and a comment is cheaper than getting it wrong.

// ---------------------------------------------------------------- shared

/// WHERE. A site is the physical thing a company operates: an estate, a
/// tower, a hotel, a festival ground, a building site.
///
/// Shared deliberately by Property, Security, Community and Hotel. A hotel
/// that is also a guarded site is ONE site with two products looking at it,
/// not two rows that drift apart.
model Site {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  kind      SiteKind @default(RESIDENTIAL)
  /// Free text on purpose: addresses are not a solved problem globally, and
  /// a rigid schema for them locks out half the markets PALTAS wants.
  address   String   @default("")
  city      String   @default("")
  /// How many units the site holds, and what it is worth in minor units.
  /// Both come straight off the `portfolio` screen, which shows them.
  unitCount Int      @default(0)
  value     Int      @default(0)
  country   String   @default("")
  lat       Float?
  lng       Float?
  note      String   @default("")
  status    String   @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings   Building[]
  zones       Zone[]
  units       Unit[]
  visitors    Visit[]
  passes      Pass[]
  vehicles    Vehicle[]
  incidents   Incident[]
  patrols     Patrol[]
  guardShifts GuardShift[]
  deliveries  Delivery[]
  workOrders  WorkOrder[]
  rooms       Room[]
  assets      Asset[]
  expenses    Expense[]
  projects    Project[]
  services    HotelService[]

  @@index([orgId])
  @@index([orgId, kind])
}

enum SiteKind {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  LAND
  HOTEL
  OFFICE
  RETAIL
  INDUSTRIAL
  WAREHOUSE
  CONSTRUCTION
  FESTIVAL
  EVENT
  SCHOOL
  CAMPUS
  HOSPITAL
  ESTATE
  OTHER
}

model Building {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name      String
  city      String            @default("")
  floors    Int               @default(0)
  unitCount Int               @default(0)
  builtYear Int?
  condition BuildingCondition @default(GOOD)
  note      String            @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units Unit[]

  @@index([orgId])
  @@index([orgId, siteId])
}

enum BuildingCondition {
  GOOD
  FAIR
  NEEDS_WORK
}

/// A lettable or sellable space. The atom of Property Management.
model Unit {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId     String?
  site       Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  buildingId String?
  building   Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  /// What the customer calls it — "A-204". Unique within a company only.
  ref          String
  /// The building as the person typed it. The relation above is the truth
  /// once a building is picked; this is what the `units` form collects.
  buildingName String     @default("")
  kind         UnitKind   @default(ONE_BED)
  floor        Int?
  sqm          Int?
  /// Asking rent per month, in minor units.
  rent         Int        @default(0)
  currency     String     @default("KES")
  status       UnitStatus @default(VACANT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leases   Lease[]
  listings Listing[]

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([orgId, status])
}

enum UnitKind {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  FOUR_BED
  SHOP
  OFFICE
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  NOTICE
  RESERVED
  OFF_MARKET
}

/// A person or company this organization deals with: a tenant, an owner, a
/// buyer, a guest, a contractor, a vendor.
///
/// ONE TABLE, NOT SIX. The same human is often a tenant in one building and
/// a buyer in another, and six tables means six half-truths about them.
model Party {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name  String
  kind  PartyKind @default(CONTACT)
  email String    @default("")
  phone String    @default("")
  /// A resident lives in a unit and keeps cars. Text and a count, because
  /// the `s_residents` form collects both before a Unit record may exist.
  unit  String    @default("")
  cars  Int       @default(0)
  note  String    @default("")
  since DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leases       Lease[]       @relation("LeaseTenant")
  deals        Deal[]
  viewings     Viewing[]
  reservations Reservation[]
  invoices     Invoice[]
  visits       Visit[]       @relation("VisitHost")
  expenses     Expense[]     @relation("ExpenseVendor")
  payouts      Payout[]      @relation("PayoutBeneficiary")

  @@index([orgId])
  @@index([orgId, kind])
  @@index([orgId, name])
}

enum PartyKind {
  OWNER
  BUYER
  TENANT
  GUEST
  CONTACT
  CONTRACTOR
  VENDOR
  STAFF
  RESIDENT
}

/// The register of documents. NO FILE BYTES — a provider reference only.
model Document {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  kind      DocumentKind @default(OTHER)
  /// Who or what it is about, as free text until it needs to be a relation.
  about     String       @default("")
  expiresAt DateTime?

  /// WHERE THE BYTES ACTUALLY ARE. A key in object storage, never content.
  storageKey String @default("")
  /// So a tampered or truncated file is detectable.
  checksum   String @default("")
  bytes      Int    @default(0)
  mimeType   String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, kind])
  @@index([orgId, expiresAt])
}

enum DocumentKind {
  OWNERSHIP
  LEASE
  COMPLIANCE
  INSURANCE
  TAX
  IDENTITY
  CONTRACT
  INVOICE
  OTHER
}

/// EVERY SENSITIVE OR ADMINISTRATIVE ACTION, APPEND-ONLY.
///
/// Not a log file — a table, queryable, scoped to a company, and never
/// updated or deleted. "Who changed this, when, and what did it say before"
/// is a question that gets asked exactly when nobody can answer it.
model AuditEvent {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// The person, kept as a relation AND a name: a leaver must not erase the
  /// record of what they did.
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String  @default("")

  action   String
  entity   String
  /// NOT a foreign key, and that is deliberate: this log records actions
  /// against every table, and the row it describes may since have been
  /// deleted — which is often the very action being recorded.
  entityId String @default("")
  /// What changed, as JSON. Never secrets, never document bytes.
  detail   Json?
  ip       String @default("")

  at DateTime @default(now())

  @@index([orgId, at])
  @@index([orgId, entity, entityId])
}

// ============================================ PROPERTY MANAGEMENT
//
// Portfolios, leases, rent and the money that follows. Development and
// Community share these tables rather than duplicating them — see Project
// and the `community` fields below, and AUDIT.md for why that is still an
// open product decision rather than a settled one.

model Lease {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unitId   String?
  unit     Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenantId String?
  tenant   Party?       @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: SetNull)

  ref        String
  /// Tenant and unit as typed. The relations above are the truth when set;
  /// these are what the `rentals` form collects before a tenant exists as
  /// a contact of its own.
  tenantName String      @default("")
  unitRef    String      @default("")
  /// Minor units.
  rent       Int         @default(0)
  currency   String      @default("KES")
  deposit    Int         @default(0)
  startsOn   DateTime?
  endsOn     DateTime?
  status     LeaseStatus @default(ACTIVE)
  note       String      @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@unique([orgId, ref])
  @@index([orgId])
  @@index([orgId, status])
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  NOTICE
  ENDED
  TERMINATED
}

/// A development project. Property Development lives here.
model Project {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name     String
  city     String       @default("")
  units    Int          @default(0)
  dueOn    DateTime?
  stage    ProjectStage @default(PLANNING)
  /// Minor units.
  budget   Int          @default(0)
  spent    Int          @default(0)
  currency String       @default("KES")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, stage])
}

enum ProjectStage {
  PLANNING
  APPROVALS
  GROUNDWORK
  STRUCTURE
  FIT_OUT
  HANDOVER
  COMPLETE
  ON_HOLD
}

/// A resident's report, a tenant's complaint, an inspection finding — and
/// a hotel guest's broken air conditioner. ONE work queue, many sources,
/// because a building does not care which product raised the job.
model WorkOrder {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  ref        String
  title      String
  detail     String       @default("")
  kind       WorkKind     @default(OTHER)
  priority   WorkPriority @default(NORMAL)
  status     WorkStatus   @default(OPEN)
  /// Where — a unit ref, a room number, "lift lobby". Free text on purpose.
  place      String       @default("")
  /// Who it is with. A name until staff are modelled per product.
