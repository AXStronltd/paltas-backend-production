  kind   ZoneKind @default(GATE)
  note   String   @default("")
  active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passes Pass[]
  visits Visit[]

  @@index([orgId, siteId])
}

enum ZoneKind {
  GATE
  ENTRANCE
  LOBBY
  CAR_PARK
  FLOOR
  RESTRICTED
  PERIMETER
  STAGE
  LOADING_BAY
  OTHER
}

/// Somebody arriving. Deliberately separate from Party: a visitor is an
/// EVENT, not a relationship, and conflating the two is how a one-off
/// courier ends up in the resident register forever.
model Visit {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId String?
  site   Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  hostId String?
  host   Party?       @relation("VisitHost", fields: [hostId], references: [id], onDelete: SetNull)
  /// WHICH GATE. Nullable because a visit can be pre-registered before anybody
  /// picks a lane, and because every row written before this column existed
  /// genuinely does not know. A console reading gate-by-gate must treat "not
  /// recorded" as unknown, never as "not there".
  zoneId String?
  zone   Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  visitor  String
  category VisitCategory @default(GUEST)
  hostName String        @default("")
  phone    String        @default("")
  vehicle  String        @default("")
  purpose  String        @default("")
  status   VisitStatus   @default(WAITING)

  /// Identity checking is a REFERENCE, never a scan. See Document.
  idKind String @default("")
  idRef  String @default("")

  arrivedAt  DateTime  @default(now())
  admittedAt DateTime?
  leftAt     DateTime?
  decidedBy  String    @default("")
  decidedWhy String    @default("")

  /// Distinct from arrivedAt on purpose: a visit can be pre-registered days
  /// before anybody arrives, and "when was this record made" is a different
  /// question from "when did they turn up" in any dispute about either.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([orgId, siteId, arrivedAt])
  @@index([orgId, zoneId, arrivedAt])
}

enum VisitCategory {
  GUEST
  CONTRACTOR
  DELIVERY
  STAFF
  VIEWING
  INTERVIEW
  OTHER
}

enum VisitStatus {
  WAITING
  APPROVED
  REFUSED
  INSIDE
  LEFT
  EXPIRED
}

